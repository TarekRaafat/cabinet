#!/usr/bin/env bash
# cabinet: one person, a whole team; build anything with AI agents, and stay in charge.
#
# Every command and option is in commands_table below: help, per-command --help,
# help --json and tab completion are all made from it, and the tests check the docs
# and the option parsers against it. A new command or option starts there.
#
# Kit files (CABINET.md, bin/, .cabinet/) are copied into each workspace; an update replaces
# them, but never one that was edited there. Project files (AGENTS.md, cabinet.env, roles/,
# jobs/, HANDOFFS.md, ...) are placed once by new or init, and changed only by config.
# Full reference: docs/commands.md.
set -euo pipefail

KIT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
LIBJS="$KIT/scripts/lib.js"   # the kit's JavaScript, run with node (AGENTS.md, rule 3)
VERSION="$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$KIT/package.json")"   # read before node is checked (below)
source "$KIT/scripts/when.sh"   # when_norm, when_calendar, when_human: the same parser the workspace scripts use
source "$KIT/scripts/platform.sh"   # this machine: logs, dates, the passphrase, schedules

# -C <dir>, before the command: run as if started in <dir>, as git does. Commands find the
# workspace from the current folder upward, so this is how any of them names another workspace.
if [[ "${1:-}" == -C ]]; then
  [[ -n "${2:-}" ]] || { echo "$ERR_TAG -C needs a folder" >&2; exit 2; }
  cd "$2" 2>/dev/null || { echo "$ERR_TAG -C $2: no such folder" >&2; exit 2; }
  shift 2
fi

# A global install hands off to the workspace's own pinned copy, so "cabinet update"
# applies the version the project pinned, not whatever is installed globally.
# Only for update, status and config, and only into a cabinet workspace (the nearest from
# here upward): a stray node_modules elsewhere is never run.
case "${1:-}" in update|status|config)
  wsd=""
  d="$(pwd -P)"
  while :; do
    [[ -f "$d/.cabinet/version" ]] && { wsd="$d"; break; }
    [[ -f "$d/cabinet/.cabinet/version" ]] && { wsd="$d/cabinet"; break; }
    [[ "$d" == / ]] && break; d="$(dirname "$d")"
  done
  # The pin sits in the workspace, or in the project above a cabinet/ workspace.
  for pinned in "$wsd/node_modules/@tarekraafat/cabinet" "$wsd/../node_modules/@tarekraafat/cabinet"; do
    [[ -n "$wsd" ]] || break
    if [[ -z "${CABINET_PINNED:-}" && -x "$pinned/bin/cabinet" && "$(cd "$pinned" && pwd -P)" != "$(cd "$KIT" && pwd -P)" ]]; then
      CABINET_PINNED=1 exec "$pinned/bin/cabinet" "$@"
    fi
  done ;;
esac

die() { echo "$ERR_TAG $*" >&2; exit 1; }
# need_deps <yes>: stop unless the tools cabinet needs are here. In a terminal, offers to install
# the missing ones and shows the command first; with --yes (scripts, agents) it never installs.
need_deps() {
  local miss a="" c v; miss="$(deps_missing)"
  if [[ -z "$miss" ]]; then
    v="$(node_old)" && die "cabinet needs Node.js $NODE_MIN or newer; this is $v ($(node_hint)), then run this again"
    return 0
  fi
  echo "cabinet needs ${miss// /, }, not found on this machine." >&2
  if c="$(deps_cmd "$miss")"; then
    if (($1 == 0)) && { exec 4<"${CABINET_TTY:-/dev/tty}"; } 2>/dev/null; then
      read -r -u 4 -p "  Install now with: $c? [Y/n]: " a || true; exec 4<&-
      if [[ "${a:-y}" == [Yy]* ]] && deps_install "$miss" && [[ -z "$(deps_missing)" ]]; then return 0; fi
    fi
    die "install them, then run this again: $c"
  fi
  die "$(deps_hint "$miss"), then run this again"
}
# deps_gate <command's arguments>: need_deps, never installing with --yes or --dry-run, skipped for --help.
deps_gate() {
  local x quiet=0
  for x in "$@"; do case "$x" in --help|-h) return 0 ;; --yes|-y|--dry-run) quiet=1 ;; esac; done
  need_deps "$quiet"
}
bad_usage() { echo "$ERR_TAG $*" >&2; exit 2; }   # wrong usage: an unknown command or option, a missing value
need() { [[ $# -ge 3 && -n "$3" ]] || bad_usage "$1"; }   # need "<message>" "$@": the option's value is there

# Tab separated. C: group, command (a word, or a noun and a verb), arguments, summary.
# O: the commands it applies to (comma separated), option, value, text.
# The conventions every command follows are in AGENTS.md, "Command conventions".
commands_table() {
  cat <<'TABLE'
C	Start	new	[dir] [options]	Create a workspace in a new or empty folder. Asks its questions in a terminal; --yes takes the defaults.
C	Start	init	[dir] [options]	Add cabinet to an existing project, or make a folder of repos the workspace (default: this folder).
C	Daily	next		What to do next in this workspace, in order. Changes nothing.
C	Daily	brief		Write the brief now (runs the brief job).
C	Daily	digest		One morning read: the sign-off queue and your actions from the latest brief of every workspace on this machine.
C	Daily	list		Every workspace on this machine: its kit version, what waits on you, what the doctor finds, the latest brief.
C	Daily	doctor		Check everything (repos, roles, guardrails, schedules, backups) and say how to fix it.
C	Team	role add	<name> [options]	Turn on a kit role, or add a role of the project's own from as little as its name.
C	Team	role remove	<name>	Turn a role off. A role of the project's own keeps its file in roles/.
C	Daily	manual build		Write OPERATIONS.html, the owner's manual as one page, from OPERATIONS.md.
C	Team	role list		Every role on the team, and the optional kit roles that are off.
C	Team	role draft	<name>	Have an agent draft a role you added, for this project (runs the agent tool; it may cost money).
C	Team	role build		Build the role definitions from the kit's roles and roles/.
C	Team	handoff add	--from <name> --to <name> --changed "..." --needed "..." "title"	File a handoff with the next free ID and today's date, and commit it.
C	Team	handoff attach	<ID> <file or URL>... --from <name>	Add evidence to your own handoff: files copied to specs/evidence/<ID>/, linked, committed.
C	Team	handoff record	<ID> --role <role> <PASS|BLOCK|CHANGES> --commits <hash,...>|none --note <file>	Record a reviewer's verdict on a handoff in the one format, and commit it.
C	Team	spec check	[spec]	Check each spec against its status: ready needs criteria qa passed, no TBD, every decision answered.
C	Team	spec record	<spec> --role <qa|architect|design-lead> <PASS|BLOCK> --note <file>	Record qa's review of a spec's acceptance criteria, design-lead's of its design, or architect's of its plan, and commit it.
C	Team	spec run	<spec> [--retries <n>]	Move a ready spec through routing, plans and each of its handoffs with agent runs, until all its work is ready to push.
C	Team	handoff list	[name] [--ready]	Open handoffs, oldest first; with a repo or role name, everything addressed to it, in full; --ready, the work ready to push.
C	Team	handoff run	<ID> [--retries <n>]	Move one piece of work through build, review and fixes with agent runs, until it is ready to push or needs you.
C	Team	handoff archive		Move closed handoffs to handoffs/archive-YYYY-MM.md and commit the move.
C	Work	repo add	<git url>	Add a product repo; bootstrap clones it and gives it a builder.
C	Work	repo remove	<name>	Take a repo out of repos.tsv and the team table; its folder is left as it is.
C	Work	repo list		Every repo: its owner, whether it is on this machine, where it lives.
C	Work	repo snapshot		Copy each repo's local-only files into local/.
C	Work	job run	<job>	Run a job from jobs/ now.
C	Work	job list		Every job: its role, schedule and time limit.
C	Safety	secret check		Look for keys, tokens and passwords in the workspace's files (file and line, never the value).
C	Safety	backup create	[folder]	One encrypted backup now (default folder: CABINET_BACKUP_DIR).
C	Safety	backup verify	[folder]	Restore the newest archive into a temporary folder, check it against the workspace and its repos, delete it.
C	Safety	backup restore	<archive> [dir]	Rebuild a workspace and its repos from a backup, never losing a file. Works before any workspace exists.
C	Setup	bootstrap		Set up this machine for the workspace: repos, builders, guardrails, schedules. Safe to rerun.
C	Setup	config	[options]	Change settings: the setup questions again, with the current answers as defaults.
C	Setup	move	<new-path>	Move the workspace folder and update what remembers its path.
C	Setup	remove		Remove this workspace from this machine after showing the plan: schedules, logs, folder, and what setup added to a project.
C	Kit	update		Apply the installed kit to this workspace and print the changelog since its version.
C	Kit	status		This workspace's kit version, the installed kit's, and every kit file edited here.
C	Kit	outdated		Is a newer kit published? Compares this workspace, the installed kit and the npm registry.
C	Kit	changelog	[from-version]	What changed since a version (all versions when left out).
C	Kit	completion	bash|zsh	Tab completion: add eval "$(cabinet completion zsh)" to ~/.zshrc.
C	Kit	version		The installed kit's version.
C	Kit	help	[command]	Every command, or one command's options.
O	new,init,config	--name	"Name"	The project's display name (default: the folder name).
O	new,init,config	--slug	<slug>	Short name for schedules, logs and backups: lowercase letters, digits, dashes.
O	new,init,config	--owner	"Name"	The commit author (default: git config user.name).
O	new,init,config	--email	<email>	The commit author's email (default: git config user.email).
O	new,init,config	--roles	"qa security ..."	Roles to enable; chief-of-staff is always on (default: the seven core roles, and code-reviewer when the workspace starts with repos).
O	new,init,config	--runner	<tool>	Agent tool for scheduled jobs: claude, codex, antigravity, qwen, grok, opencode, cursor or custom.
O	new,init,config	--runner-cmd	'<command>'	With --runner custom: the command, using "$CABINET_PROMPT".
O	new,init,config	--brief-time	<when>	A time every day ("7 AM"), days and a time ("fri 4 PM", "sun,mon,tue,wed,thu 8:30 AM"), or off (default: 7:00 AM).
O	new,init,config	--week-start	<day>	First day of the week (default: sunday).
O	new,init,config	--writing	short|standard	How agents write to you: short gives the shortest briefs, questions and answers (default: standard).
O	new,init,config	--credit-roles	off|on	Credit roles: each commit a role makes in a Cabinet run credits that role beside you, as one Co-authored-by line with the Cabinet Team avatar on GitHub (default: on; asked once in an older workspace).
O	new,init,config	--credit-email	<email>|off	With --credit-roles on: your own GitHub App's bot noreply email instead of the Cabinet Team's; off goes back to it.
O	new,init,config	--backup-dir	<folder>|off	Folder for the daily encrypted backup, outside the workspace (default: off).
O	config	--pipeline	off|small|all	The scheduled runner: off (default), small (only small tasks) or all (small tasks and ready specs). It runs agents unattended.
O	config	--pipeline-limit	<dollars>	What one scheduled run may spend; needed to turn the runner on.
O	config	--pipeline-time	<when>|off	When the scheduled runner runs (default: 10:00 PM); off runs it only by hand.
O	config	--hard-to-undo	"<repo>/<path> ..."|off	Paths where a change is hard to undo (migrations, public API files): a small task never touches them. Written into AGENTS.md.
O	config	--backup-time	<time>	Time of the daily backup, like "1 PM" (default: 1:00 PM).
O	new,init,config	--budget	<dollars>|off	A weekly budget in US dollars for the agent runs cabinet starts; the doctor warns from 80% (default: off).
O	new,init,config	--price	"<input> <output> [<cached>]"|off	Dollars per million tokens, to count runs of a runner that reports only tokens: codex, cursor, qwen, antigravity (default: off).
O	new,init,config	--repo	<git url>	A product repo to clone; repeat for more.
O	init	--inside		In a project repo: the workspace is cabinet/ inside it (the default there).
O	init	--private		With --inside (the default): cabinet/ has its own git; no tracked project file changes.
O	init	--shared		With --inside: cabinet/ is committed with the project.
O	init	--beside		In a project repo: the workspace is a folder next to it.
O	init	--workspace	<folder>	With --beside: where that folder goes (default: <project>-hq).
O	config	--apply		Run bootstrap after the change without asking.
O	config	--this-machine		With --backup-dir, --backup-time or --credit-roles: set them for this machine only, in cabinet.local.env (not committed).
O	config	--clear		With --this-machine: this machine follows the backup settings in cabinet.env again.
O	repo add	--apply		Run bootstrap right after, which clones the repo and gives it a builder.
O	bootstrap	--no-schedules		From now on, schedule no jobs on this machine: another machine runs them (saved in cabinet.local.env, not committed).
O	bootstrap	--schedules		Schedule this machine's jobs again (undoes --no-schedules).
O	role add	--does	"..."	What it should do, in your words (asked in a terminal when no option is given).
O	role add	--owns	"..."	The repos, folders or areas it owns.
O	role add	--decides	"..."	What it may decide on its own.
O	role add	--escalates	"..."	What it must bring to you.
O	role add	--reports-to	<role>	The lead this role reports to: a sub-team role in that lead's function.
O	role add	--covers	"<builders or repos>"	With --reports-to: whose work it reviews for its lead; its verdicts count for the lead's there, the lead's PASS too for its first 30 days.
O	role add	--title	"..."	Its title, as experts are named in decisions and on the org page ("Head of Product"); also when turning on a kit role.
O	role add	--name	"..."	Its display name ("Product Agent"); also when turning on a kit role.
O	role add	--function	"..."	The function it belongs to on the org page, when not its lead's (default: its lead's, or Other).
O	role add	--draft		Draft it now with the configured agent tool (it may cost money).
O	role build	--check		Only report what is missing or out of date.
O	manual build	--check		Only report whether OPERATIONS.html is older than OPERATIONS.md.
O	handoff add	--from	<repo or role>	Who files it.
O	handoff add	--to	<repo, role or owner>	Who it is for.
O	handoff add	--changed	"..."	Exactly what changed: endpoint, field, limit, status code, default, version, file.
O	handoff add	--needed	"..."	What the addressee has to do.
O	handoff add	--depends-on	"..."	The commit or branch it depends on (default: none).
O	handoff add	--spec	<file>	The spec it builds; refused unless the spec is ready to build (cabinet spec check).
O	handoff add	--small		A small task: one repo, no contract change, no owner decision, easy to undo. Work for a builder needs this or --spec.
O	handoff add	--evidence	<file or URL>	What shows the work: a file (copied into specs/evidence/<ID>/) or a link. Once for each.
O	handoff attach	--from	<repo or role>	Who adds it: the handoff's sender, and no one else.
O	handoff record	--role	<role>	The reviewer recording it (qa, security, code-reviewer, ...).
O	handoff record	--commits	<hash,...>|none	The commits reviewed, joined by commas; none for work that changes no repo (not for work addressed to a builder).
O	handoff record	--note	<file>	The reviewer's committed note under specs/, with the details.
O	spec record	--role	<qa|architect|design-lead>	qa reviews the acceptance criteria; design-lead the design; architect the plan.
O	spec record	--note	<file>	The reviewer's committed note under specs/, with the details.
O	handoff run	--retries	<n>	Fix rounds after a BLOCK before it stops and asks you (default 2).
O	spec run	--retries	<n>	Fix rounds after a BLOCK, for each of its handoffs, before it stops and asks you (default 2).
O	handoff list	--ready		Only the work every reviewer it needs has passed, at its latest commits: ready for you to push.
O	secret check	--staged		Only the lines staged for the next commit (the workspace's pre-commit hook runs this).
O	doctor	--fix		Then run the fixes it knows (bootstrap, roles, snapshot, installing missing tools), asking before each.
O	digest	--write	<file>	Write the digest to this file instead of the screen.
O	digest	--notify		Also show a desktop notification with the counts (with --write or --schedule).
O	digest	--schedule	[<when>|off]	Write it on a schedule (default: every day at 10:00 AM), or at another time ("8 AM"), or on days and a time ("fri 10 AM", "sun,mon,tue,wed,thu 8 AM"); off stops it.
O	digest	--file	<file>	With --schedule: where it is written (default: digest.md in the log folder, ~/Library/Logs/cabinet/ on macOS, ~/.local/state/cabinet/ on Linux).
O	remove	--force		Remove even with uncommitted changes or commits on no remote.
O	remove	--delete-key		Also delete the backup passphrase from the keychain or secret store, and its passphrase file.
O	new,init,config,bootstrap,move,remove,role add,role remove,repo add,repo remove,handoff run,spec run	--dry-run		Print what it would do, and change nothing.
O	new,init,config,remove,role add,doctor	--yes		No questions (or -y). For doctor, with --fix.
O	next,digest,list,doctor,status,outdated,changelog,version,help,role list,handoff list,spec check,repo list,job list,secret check,backup verify	--json		The result as JSON, for agents and scripts.
TABLE
}
is_cmd() { commands_table | awk -F'\t' -v c="$1" '$1 == "C" && $3 == c {f = 1} END {exit !f}'; }
# A noun: the first word of two-word commands (role, repo, handoff, spec, manual, job, backup, secret).
is_noun() { commands_table | awk -F'\t' -v n="$1" '$1 == "C" && index($3, n " ") == 1 {f = 1} END {exit !f}'; }

cmd_help() {
  local json=0 one="" x
  for x in "$@"; do case "$x" in --json) json=1 ;; -*) bad_usage "unknown option $x" ;; *) one="${one:+$one }$x" ;; esac; done
  [[ -z "$one" ]] || is_cmd "$one" || is_noun "$one" || bad_usage "unknown command '$one' (see: cabinet help)"
  if ((json)); then
    commands_table | json -R --arg v "$VERSION" --arg one "$one" '((t) => ({name: "cabinet", version: $v, docs: "docs/commands.md", commands: t
      .filter((c) => c[0] == "C")
      .map((c) => ({name: c[2], group: c[1], usage: "cabinet " + c[2] + (c[3] == "" ? "" : " " + c[3]), summary: c[4],
        options: t.filter((o) => o[0] == "O" && o[1].split(",").includes(c[2])).map((o) => ({name: o[2], value: o[3], text: o[4]}))}))
      .filter((c) => $one == "" || c.name == $one || c.name.startsWith($one + " "))}))($.map((l) => l.split("\t")))'
    return 0
  fi
  if [[ -n "$one" ]] && ! is_cmd "$one"; then
    # A noun alone: its verbs.
    echo "cabinet $one <verb>"; echo
    commands_table | awk -F'\t' -v n="$one" '$1 == "C" && index($3, n " ") == 1 {printf "  %-34s %s\n", $3 ($4 == "" ? "" : " " $4), $5}'
    echo; echo "cabinet $one <verb> --help shows its options. Full reference: $KIT/docs/commands.md"
    return 0
  fi
  if [[ -n "$one" ]]; then
    commands_table | awk -F'\t' -v c="$one" '
      $1 == "C" && $3 == c { args = $4; text = $5 }
      $1 == "O" && ("," $2 ",") ~ ("," c ",") { opts = opts sprintf("  %-30s %s\n", $3 ($4 == "" ? "" : " " $4), $5) }
      END { if (opts != "" && args !~ /options/) args = args (args == "" ? "" : " ") "[options]"
            printf "Usage: cabinet %s%s\n\n%s\n", c, (args == "" ? "" : " " args), text
            if (opts != "") printf "\nOptions:\n%s", opts }'
    echo; echo "Full reference: $KIT/docs/commands.md"
    return 0
  fi
  echo "cabinet $VERSION: one person, a whole team; build anything with AI agents, and stay in charge."
  # One heading per group, in the order each group first appears; its commands in table order.
  commands_table | awk -F'\t' '$1 == "C" { if (!($2 in rows)) order[++n] = $2
      rows[$2] = rows[$2] sprintf("  %-34s %s\n", $3 ($4 == "" ? "" : " " $4), $5) }
    END { for (i = 1; i <= n; i++) printf "\n%s\n%s", order[i], rows[order[i]] }'
  echo
  echo "Every command works from any folder inside a workspace or its project; cabinet -C <dir> <command> runs it as if started in <dir>."
  echo "cabinet <command> --help shows its options. Full reference: $KIT/docs/commands.md"
}

# Changelog sections newer than $1 (all when empty), up to this version.
changelog() {
  local from=${1:-} v
  awk -v from="$from" -v to="$VERSION" '
    function newer(a, b,   x, y, i, n) { n = split(a, x, "."); split(b, y, "."); for (i = 1; i <= 3; i++) if (x[i] + 0 != y[i] + 0) return x[i] + 0 > y[i] + 0; return 0 }
    /^## [0-9]+\.[0-9]+\.[0-9]+/ { v = $2; on = (from == "" || newer(v, from)) && !newer(v, to) }
    /^## / && !/^## [0-9]/ { on = 0 }
    on { print }
  ' "$KIT/CHANGELOG.md"
}

# Every kit file as "<kit path> <workspace path>".
managed() {
  echo "core/CABINET.md CABINET.md"
  local f
  for f in "$KIT"/core/rules/*.md; do echo "core/rules/${f##*/} .cabinet/rules/${f##*/}"; done
  for f in "$KIT"/scripts/*; do echo "scripts/${f##*/} bin/${f##*/}"; done
  for f in "$KIT"/roles/*.md; do echo "roles/${f##*/} .cabinet/roles/${f##*/}"; done
  for f in "$KIT"/guardrails/*; do echo "guardrails/${f##*/} .cabinet/guardrails/${f##*/}"; done
}

# Copy kit files into <ws>. Returns 1 when an edited file blocked the update.
sync_kit() {
  local ws=$1 man="$1/.cabinet/manifest" next blocked=0 src dst live want had cur h p
  mkdir -p "$ws/.cabinet"; next="$(mktemp)"
  touch "$man"
  while read -r src dst; do
    live="$ws/$dst" want="$(sha256 "$KIT/$src")"
    had="$(awk -v p="$dst" '$2 == p {print $1}' "$man")"
    if [[ -f "$live" ]]; then
      cur="$(sha256 "$live")"
      if [[ "$cur" == "$want" ]]; then echo "$want $dst" >> "$next"; continue; fi
      if [[ "$cur" != "$had" ]]; then
        # A file the kit never placed (it was there before) is recorded as "-",
        # so every later update and the doctor keep treating it as not the kit's.
        if [[ -z "$had" || "$had" == - ]]; then echo "  already here and not the kit's, left as is: $dst"
        else echo "  edited here, left as is: $dst"; fi
        blocked=1; echo "${had:--} $dst" >> "$next"; continue
      fi
      echo "  updated $dst"
    else
      echo "  added $dst"
    fi
    mkdir -p "$(dirname "$live")"
    cp "$KIT/$src" "$live"
    [[ -x "$KIT/$src" || "$dst" == bin/*.sh ]] && chmod +x "$live"
    echo "$want $dst" >> "$next"
  done < <(managed)
  # Kit files the kit no longer ships: removed when unedited.
  while read -r h p; do
    [[ -z "${p:-}" ]] && continue
    # A manifest path outside the workspace is never acted on (a shared workspace's manifest is not trusted).
    [[ "$p" == /* || "$p" == *..* ]] && continue
    awk -v p="$p" '$2 == p {f=1} END {exit !f}' "$next" && continue
    if [[ -f "$ws/$p" && "$(sha256 "$ws/$p")" != "$h" ]]; then
      echo "  left the kit but edited here, left as is: $p"
    else
      rm -f "$ws/$p"; echo "  removed $p (no longer in the kit)"
    fi
  done < "$man"
  sort -k2 "$next" > "$man"; rm -f "$next"
  return "$blocked"
}

RUNNERS="claude codex antigravity qwen grok opencode cursor"   # built in; "custom" runs a command
ROLES_ALL="chief-of-staff product-manager architect qa security design-lead finance"
ROLES_OPT="brand-designer dba code-reviewer auditor"   # kit roles a project turns on; off by default
DAYS="sunday monday tuesday wednesday thursday friday saturday"

# Prompts read the terminal itself on fd 3, so they work under npx and npm exec
# too. CABINET_TTY points them at a file of answers instead (the tests use it).
ask() {  # ask <question> <default>: the answer, or the default on Enter
  local a=""; read -r -u 3 -p "  $1 [$2]: " a || true; printf '%s' "${a:-$2}"
}
confirm() {  # confirm <question> <y|n default>
  local a="" hint="y/N"; [[ $2 == y ]] && hint="Y/n"
  read -r -u 3 -p "  $1 [$hint]: " a || true; a="${a:-$2}"; [[ "$a" == [Yy]* ]]
}
slugify() { printf %s "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
has() { [[ " $1 " == *" $2 "* ]]; }

# The absolute, symlink-free form of a path that may not exist yet.
abspath() {
  local p="$1" tail=""
  case "$p" in "~") p="$HOME" ;; "~/"*) p="$HOME/${p#"~/"}" ;; /*) ;; *) p="$PWD/$p" ;; esac
  while [[ ! -d "$p" ]]; do tail="/${p##*/}$tail"; p="$(dirname "$p")"; done
  printf '%s%s' "$(cd "$p" && pwd -P)" "$tail"
}
within() { local a b; a="$(abspath "$1")" b="$(abspath "$2")"; [[ "$a" == "$b" || "$a" == "$b"/* ]]; }

# Values written into cabinet.env, which every script loads as shell: nothing that
# could run or break out ($, backtick, backslash, double quote, control characters).
safe() { [[ "$1" != *[\$\`\\\"]* && "$1" != *[[:cntrl:]]* ]]; }
# A relative path (./x, ../x) is relative to the workspace, as bootstrap clones it.
url_ok() { [[ "$1" =~ ^(https://|http://|ssh://|git://|file://|git@[A-Za-z0-9.-]+:|/|\./|\.\./)[^[:space:][:cntrl:]]*$ ]]; }
name_ok() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ && "$1" != . && "$1" != .. ]]; }
# A role name: lowercase ASCII letters, digits and dashes (C: a-z is ASCII only).
role_ok() { local LC_ALL=C; [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }
# env_ok <setting> <value>: a value written to cabinet.env in double quotes, given now or carried
# over, passes safe as well as its own check, before anything is written.
env_ok() { safe "$2" || die "$1 is '$2', which cannot be written back: no \$, backtick, backslash, double quote or line break. Set it again with cabinet config, or correct it by hand"; }

# The workspace that already uses a slug on this machine (its schedules or its log folder),
# if not <ws>. Paths are compared with symlinks resolved.
slug_owner() {
  local slug=$1 ws f other=""
  ws="$(abspath "$2")"
  for f in "$SCHED_DIR/ai.cabinet.$slug".*"$SCHED_EXT"; do
    [[ -f "$f" ]] || continue
    other="$(sched_ws "$f")"
    [[ -n "$other" && "$(abspath "$other")" != "$ws" ]] && { echo "$other"; return; }
  done
  f="$LOGROOT/$slug/workspace"
  [[ -f "$f" && "$(abspath "$(cat "$f")")" != "$ws" ]] && cat "$f"
  return 0
}
# Why a slug cannot be used, and what to do about it.
slug_taken() {  # slug_taken <slug> <other workspace>
  if [[ -d "$2" ]]; then echo "the slug '$1' is already used by the workspace at $2"
  else echo "the slug '$1' is still held by a workspace at $2, which no longer exists. To free it: for each of its schedules, $(sched_stop_cmd "ai.cabinet.$1.<job>"); then delete $LOGROOT_SHOWN/$1/workspace"; fi
}
# Record which workspace owns a slug, so another setup sees it even before bootstrap runs.
claim_slug() { mkdir -p -m 700 "$LOGROOT/$1" 2>/dev/null && printf '%s\n' "$(abspath "$2")" > "$LOGROOT/$1/workspace"; return 0; }

# The budget question, for setup and config. A runner that reports only tokens also needs a price.
ask_budget() {
  local rn; rn="$(printf %s "$runner" | tr '[:upper:]' '[:lower:]')"
  has "$RUNNERS" "$rn" || return 0
  echo "  A weekly budget for the agent runs cabinet starts, in US dollars: the doctor and the brief warn from 80%."
  budget="$(ask "Weekly budget, like 20, or off" "${budget:-off}")"
  [[ "$budget" != off && -n "$budget" ]] && has "codex cursor qwen antigravity" "$rn" || return 0
  echo "  $rn reports tokens, not dollars: its price in dollars per million tokens, as input, output and (optional) cached input."
  price="$(ask "Price, like 1.25 10 0.125, or off" "${price:-off}")"
}

# The checks every answer passes, for setup and config (they share these variables).
check_answers() {
  local r v
  roles="$(printf %s "$roles" | tr '[:upper:]' '[:lower:]')"; runner="$(printf %s "$runner" | tr '[:upper:]' '[:lower:]')"
  brief="$(printf %s "$brief" | tr '[:upper:]' '[:lower:]')"
  has "$roles" chief-of-staff || roles="chief-of-staff $roles"
  for r in $roles; do role_ok "$r" || die "'$r' is not a role name: lowercase letters, digits and dashes"; done
  for r in $roles; do has "$ROLES_ALL $ROLES_OPT ${extra_roles:-}" "$r" || die "unknown role '$r' (kit roles: $ROLES_ALL $ROLES_OPT${extra_roles:+; project roles: $extra_roles})"; done
  [[ "$runner" != gemini ]] || die "gemini is no longer a runner (Gemini CLI users moved to Antigravity): use --runner antigravity"
  has "$RUNNERS custom" "$runner" || die "runner must be one of: $RUNNERS, custom"
  [[ "$runner" != custom || -n "$runner_cmd" ]] || die "--runner custom needs --runner-cmd"
  [[ "$runner_cmd" != *"'"* && "$runner_cmd" != *[[:cntrl:]]* ]] || die "the runner command cannot contain single quotes or control characters"
  if [[ -n "$brief" ]]; then
    brief="$(when_norm "$brief")" || die "the brief time must be a time like \"7 AM\" or \"7:30 PM\" for every day, days and a time like \"fri 4 PM\" or \"sun,mon,tue,wed,thu 8 AM\" (day names in full work too), or off"
  fi
  has "$DAYS" "$week" || die "week start must be a day name, like sunday"
  writing="$(printf %s "$writing" | tr '[:upper:]' '[:lower:]')"
  [[ "$writing" == short || "$writing" == standard ]] || die "--writing must be short or standard"
  [[ "$(printf %s "$budget" | tr '[:upper:]' '[:lower:]')" == off ]] && budget=""
  [[ -z "$budget" || "$budget" =~ ^[0-9]+(\.[0-9]{1,2})?$ && ! "$budget" =~ ^0+(\.0*)?$ ]] || die "the budget must be dollars a week, like 20 or 12.50, or off"
  price="$(printf %s "$price" | tr -s ' \t' '  ' | sed 's/^ //; s/ $//')"
  [[ "$(printf %s "$price" | tr '[:upper:]' '[:lower:]')" == off ]] && price=""
  [[ -z "$price" || "$price" =~ ^[0-9]+(\.[0-9]+)?( [0-9]+(\.[0-9]+)?){1,2}$ ]] || die "the price must be dollars per million tokens: input and output, and optionally cached input, like \"1.25 10\" or \"1.25 10 0.125\", or off"
  for v in "$name" "$owner" "$email" "$backup"; do safe "$v" || die "'$v' cannot be used: no \$, backtick, backslash, double quote or line break"; done
  if [[ -n "$backup" ]]; then [[ "$backup" == /* ]] || die "the backup folder must be an absolute path, not '$backup'"; fi
}

# Credit roles, for setup and config: the mode is exactly off or on, and a project's own app is
# named by its bot noreply email, exactly (scripts/lib.sh and the credit hook check the same).
credit_email_ok() {
  local LC_ALL=C re='^[0-9]+\+[a-z0-9]+(-[a-z0-9]+)*\[bot\]@users\.noreply\.github\.com$'   # C: a-z is ASCII only
  [[ "$1" =~ $re ]]
}
check_credit() {   # check_credit <the mode the result has>: credit and cemail (cemail_given) can be written
  [[ -z "$credit" || "$credit" == off || "$credit" == on ]] || die "--credit-roles must be off or on"
  ((cemail_given)) || return 0
  [[ "$cemail" == off ]] || credit_email_ok "$cemail" || die "--credit-email must be a GitHub App's bot noreply email, like 123+my-app[bot]@users.noreply.github.com, or off"
  [[ "$1" == on ]] || die "--credit-email goes with --credit-roles on: with credit off, no email is used"
}
credit_question() {   # the setup question, the offered answer in $credit
  echo "  Credit roles: each commit a role makes in a Cabinet run credits that role beside you, with one Co-authored-by line"
  echo "  that shows the Cabinet Team avatar on GitHub. on, or off.$([[ -n "${1:-}" ]] && printf ' %s' "$1")"
  credit="$(ask "Credit roles" "$credit")"
}

# The backup folder must be outside every folder the workspace holds data in.
check_backup_outside() {
  local d
  [[ -n "$backup" ]] || return 0
  for d in "$@"; do
    within "$backup" "$d" && die "the backup folder $backup is inside $d. A backup there is lost with what it protects, copies itself into every later archive, and can be committed. Choose a folder outside: a synced drive or an external disk."
  done
  return 0
}

cmd_new() { setup new "$@"; }
cmd_init() { setup init "$@"; }

# One setup behind both commands. Layouts:
#   new     an empty folder becomes the workspace
#   around  an existing folder (often holding repos) becomes the workspace, in place
#   inside  a project repo gets the workspace as cabinet/ (private: its own git, ignored by the project)
#   beside  a project repo gets a workspace next to it, pointing at it where it is
# Nothing that already exists is overwritten.
setup() {
  local how=$1; shift
  local dir="" name="" owner="" email="" roles="" runner="" runner_cmd="" brief="7:00 AM" week="sunday" writing="standard" budget="" price="" backup="" yes=0 repos=() r
  local place="" visibility="" wsflag="" slug="" extra_roles="" dry=0 credit="on" cemail="" cemail_given=0
  while (($#)); do
    case "$1" in
      --name) need "--name needs a value" "$@"; name="$2"; shift 2 ;;
      --slug) need "--slug needs a value" "$@"; slug="$2"; shift 2 ;;
      --owner) need "--owner needs a value" "$@"; owner="$2"; shift 2 ;;
      --email) need "--email needs a value" "$@"; email="$2"; shift 2 ;;
      --roles) need "--roles needs a value" "$@"; roles="$2"; shift 2 ;;
      --runner) need "--runner needs a value" "$@"; runner="$2"; shift 2 ;;
      --runner-cmd) need "--runner-cmd needs a command" "$@"; runner_cmd="$2"; shift 2 ;;
      --brief-time) need "--brief-time needs a time, like 7 AM, or off" "$@"; brief="$2"; shift 2 ;;
      --week-start) need "--week-start needs a day" "$@"; week="$2"; shift 2 ;;
      --writing) need "--writing needs short or standard" "$@"; writing="$2"; shift 2 ;;
      --credit-roles) need "--credit-roles needs off or on" "$@"; credit="$2"; shift 2 ;;
      --credit-email) need "--credit-email needs an email, or off" "$@"; cemail="$2"; cemail_given=1; shift 2 ;;
      --budget) need "--budget needs dollars a week, like 20, or off" "$@"; budget="$2"; shift 2 ;;
      --price) need "--price needs dollars per million tokens, like \"1.25 10\", or off" "$@"; price="$2"; shift 2 ;;
      --backup-dir) need "--backup-dir needs a folder" "$@"; backup="$2"; shift 2 ;;
      --repo) need "--repo needs a git URL" "$@"; repos+=("$2"); shift 2 ;;
      --inside) place=inside; shift ;;
      --beside) place=beside; shift ;;
      --workspace) need "--workspace needs a folder" "$@"; wsflag="$2"; shift 2 ;;
      --private) visibility=private; shift ;;
      --shared) visibility=shared; shift ;;
      --dry-run) dry=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -*) bad_usage "unknown option $1 (see: cabinet help)" ;;
      *) dir="$1"; shift ;;
    esac
  done

  # Where we are: an existing project repo, an existing folder, or a new one.
  local layout=new host="" hostname="" top=""
  if [[ "$how" == init ]]; then
    dir="${dir:-.}"; dir="${dir/#\~/$HOME}"
    [[ -d "$dir" ]] || die "$dir does not exist (cabinet new creates a folder)"
    dir="$(cd "$dir" && pwd -P)"
    [[ -f "$dir/.cabinet/version" || -f "$dir/cabinet/.cabinet/version" ]] && die "$dir already has a cabinet workspace: use cabinet update"
    top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$top" ]]; then
      top="$(cd "$top" && pwd -P)"
      [[ "$top" == "$dir" ]] || die "$dir is inside the repo $top: run cabinet init at its top folder"
      host="$dir"; hostname="$(basename "$dir")"; layout=repo
    else
      layout=around
    fi
  fi
  [[ -n "$place" && "$layout" != repo ]] && die "--inside and --beside are for cabinet init in a project repo"

  # What an existing project already says about itself, copied as facts only:
  # its package.json name, description, scripts and repository.
  local pj="" pkg_name="" pkg_desc="" pkg_url="" pkg_run="" pkg_scripts=()
  [[ -n "$host" && -f "$host/package.json" ]] && json -e '$ !== null && typeof $ == "object" && !Array.isArray($)' "$host/package.json" >/dev/null 2>&1 && pj="$host/package.json"
  if [[ -n "$pj" ]]; then
    # A cloned project's package.json is not trusted: each value is used only if it is plain.
    pkg_name="$(json -r '((n) => (typeof n == "string" ? n.replace(/^@[^/]+\//, "") : undefined))($.displayName || $.name)' "$pj")"
    safe "$pkg_name" || { echo "  package.json name not used (it holds characters setup does not write): the folder name is the default" >&2; pkg_name=""; }
    pkg_desc="$(json -r '$.description || undefined' "$pj" | tr '\n\r\t' '   ' | tr -d '[:cntrl:]' | sed 's/ *$//')"
    pkg_url="$(json -r '((r) => ((u) => (typeof u == "string" ? u.replace(/^git\+/, "") : undefined))(typeof r == "object" ? r?.url : r))($.repository)' "$pj")"
    url_ok "$pkg_url" || pkg_url=""
    pkg_run="npm run"
    [[ -f "$host/bun.lock" || -f "$host/bun.lockb" ]] && pkg_run="bun run"
    [[ -f "$host/pnpm-lock.yaml" ]] && pkg_run="pnpm run"
    [[ -f "$host/yarn.lock" ]] && pkg_run="yarn"
    while IFS= read -r r; do [[ -n "$r" ]] && pkg_scripts+=("$pkg_run $r"); done \
      < <(json -r --each 'Object.keys(obj($.scripts)).filter((k) => ["test", "dev", "start", "build", "lint", "typecheck"].includes(k))' "$pj")
  fi

  # Defaults: the project's own name and git identity, every role, the first agent tool installed.
  [[ -n "$name" ]] || name="$pkg_name"
  [[ -n "$name" ]] || { [[ -n "$host" ]] && name="$hostname"; } || { [[ -n "$dir" ]] && name="$(basename "$dir")"; } || true
  # A repo's own git identity wins over the global one.
  local gitcfg=(git config --global); [[ -n "$host" ]] && gitcfg=(git -C "$host" config)
  [[ -n "$owner" ]] || owner="$("${gitcfg[@]}" user.name 2>/dev/null || echo TBD)"
  [[ -n "$email" ]] || email="$("${gitcfg[@]}" user.email 2>/dev/null || echo TBD)"
  # The core roles, and code-reviewer when the workspace starts with code: an owner who does not read
  # code would never see the gap it fills (.cabinet/rules/seats.md).
  if [[ -z "$roles" ]]; then
    roles="$ROLES_ALL"
    [[ -n "$host" || "$layout" == around || ${#repos[@]} -gt 0 ]] && roles+=" code-reviewer"
  fi
  if [[ -z "$runner" ]]; then
    runner=claude
    # "cursor" means the Cursor CLI (cursor-agent, or an agent inside Cursor's install), never the editor's `cursor` command.
    for r in $RUNNERS; do
      if [[ "$r" == cursor ]]; then
        { command -v cursor-agent >/dev/null || [[ "$(readlink -f "$(command -v agent 2>/dev/null)" 2>/dev/null)" == *[Cc]ursor* ]]; } && { runner=cursor; break; }
      elif command -v "$( [[ "$r" == antigravity ]] && echo agy || echo "$r")" >/dev/null; then runner=$r; break; fi
    done
  fi

  local tty=0
  if ((yes == 0)) && { exec 3<"${CABINET_TTY:-/dev/tty}"; } 2>/dev/null; then tty=1; fi
  if ((tty)); then
    case "$layout" in
      new) echo "New cabinet workspace. Press Enter to keep the value in brackets." ;;
      around) echo "cabinet workspace in $dir, around what is already there. Press Enter to keep the value in brackets." ;;
      repo) echo "cabinet for the project $hostname. Press Enter to keep the value in brackets." ;;
    esac
    echo
    if [[ "$layout" == repo ]]; then
      echo "  Inside puts the team's files in $hostname/cabinet/. Beside puts them in a folder next to $hostname."
      place="$(ask "Inside or beside" "${place:-inside}" | tr '[:upper:]' '[:lower:]')"
      if [[ "$place" == inside ]]; then
        echo "  Private: cabinet/ gets its own git, the project ignores it, and no tracked file of the project changes."
        echo "  Shared: cabinet/ is committed with the project, for everyone who clones it."
        visibility="$(ask "Private or shared" "${visibility:-private}" | tr '[:upper:]' '[:lower:]')"
      else
        wsflag="$(ask "Workspace folder" "${wsflag:-$(dirname "$host")/$hostname-hq}")"
      fi
    fi
    name="$(ask "Project name" "${name:-My Project}")"
    [[ "$layout" != new || -n "$dir" ]] || dir="$(ask "Folder" "$HOME/dev/$(slugify "$name")")"
    owner="$(ask "Owner name (commit author)" "$owner")"
    email="$(ask "Owner email" "$email")"
    echo "  Roles. chief-of-staff is always on: it writes the brief and routes work."
    local picked="chief-of-staff"
    for r in ${ROLES_ALL#chief-of-staff } $ROLES_OPT; do
      confirm "  $r" "$(has "$roles" "$r" && echo y || echo n)" && picked+=" $r"
    done
    roles="$picked"
    runner="$(ask "Agent tool for scheduled jobs (${RUNNERS// /, }, or custom)" "$runner")"
    if [[ "$runner" == custom ]]; then
      echo "  Custom tool: the command to run, with the prompt as \"\$CABINET_PROMPT\" (and the role as \$CABINET_AGENT)."
      runner_cmd="$(ask "Command" "$runner_cmd")"
    fi
    ask_budget
    brief="$(ask "Brief time: a time every day (7 AM), days and a time (fri 4 PM, sun,mon,tue,wed,thu 8 AM), or off" "$brief")"
    week="$(ask "Week starts on" "$week")"
    echo "  How agents write to you: standard, or short (the shortest briefs, questions and answers, for little time to read)."
    writing="$(ask "Writing" "$writing")"
    credit_question; credit="$(printf %s "$credit" | tr '[:upper:]' '[:lower:]')"
    echo "  Daily encrypted backup: a folder outside the workspace (a synced drive works well), or off."
    backup="$(ask "Backup folder" "${backup:-off}")"
    if [[ "$place" != inside ]]; then
      echo "  Product repos to clone into the workspace: one git URL at a time, Enter on an empty line when done."
      while r="$(ask "Repo URL" "")"; [[ -n "$r" ]]; do repos+=("$r"); done
    fi
  fi
  [[ "$layout" == repo ]] && layout="${place:-inside}"

  # The workspace folder for each layout.
  local ws
  case "$layout" in
    new) [[ -n "$dir" ]] || bad_usage "usage: cabinet new <dir> [options] (see: cabinet help)"; ws="$(abspath "$dir")" ;;
    around) ws="$dir" ;;
    inside) ws="$host/cabinet"; visibility="${visibility:-private}" ;;
    beside) ws="$(abspath "${wsflag:-$(dirname "$host")/$hostname-hq}")" ;;
    *) die "inside or beside, not '$layout'" ;;
  esac

  # Check every answer before anything is written.
  [[ "$backup" == off || -z "$backup" ]] && backup="" || backup="$(abspath "$backup")"
  [[ "$brief" == off ]] && brief=""
  week="$(printf %s "$week" | tr '[:upper:]' '[:lower:]')"
  [[ -n "$name" ]] || name="$(basename "$ws")"
  if [[ "$layout" != around ]]; then
    [[ ! -e "$ws" ]] || [[ -z "$(ls -A "$ws")" ]] || die "$ws exists and is not empty"
  fi
  [[ "$layout" != inside ]] || has "private shared" "$visibility" || die "inside is private or shared, not '$visibility'"
  check_answers
  check_credit "$credit"
  [[ "$cemail" == off ]] && cemail=""
  if [[ -z "$slug" ]]; then
    if [[ "$layout" == inside ]]; then slug="$(slugify "$hostname")"; else slug="$(slugify "$(basename "$ws")")"; fi
  fi
  [[ -n "$slug" ]] || die "the folder name gives no slug (it needs a letter or digit a-z, 0-9): pass one with --slug"
  [[ "$slug" == "$(slugify "$slug")" ]] || die "the slug must be lowercase letters, digits and dashes, like $(slugify "$slug")"
  # Two workspaces with one slug would share schedules, logs, backups and the backup key.
  local other; other="$(slug_owner "$slug" "$ws")"
  while [[ -n "$other" ]]; do
    ((tty)) || die "$(slug_taken "$slug" "$other"): choose another with --slug"
    echo "  $(slug_taken "$slug" "$other")."
    slug="$(ask "Slug for this one" "$slug-2")"
    [[ "$slug" == "$(slugify "$slug")" && -n "$slug" ]] || die "the slug must be lowercase letters, digits and dashes"
    other="$(slug_owner "$slug" "$ws")"
  done

  # Repos the workspace starts with: found ones where they are, then URLs to clone.
  # repos.tsv columns: name, clone URL, local-only files, CLAUDE.md link, path (empty: <workspace>/<name>).
  local rows=()
  local d rn url
  local hrn=""
  if [[ -n "$host" ]]; then
    url="$(git -C "$host" remote get-url origin 2>/dev/null || true)"; url_ok "$url" || url="${pkg_url:--}"
    hrn="$hostname"; name_ok "$hrn" || hrn="$(slugify "$hostname")"
    if [[ "$layout" == inside ]]; then rows+=("$hrn"$'\t'"$url"$'\t-\tno\t..')
    elif [[ "$(dirname "$ws")" == "$(dirname "$host")" ]]; then rows+=("$hrn"$'\t'"$url"$'\t-\tno\t'"../$hostname")
    else rows+=("$hrn"$'\t'"$url"$'\t-\tno\t'"$host"); fi
  elif [[ "$layout" == around ]]; then
    for d in "$ws"/*/; do
      [[ -e "$d/.git" ]] || continue
      rn="$(basename "$d")"; name_ok "$rn" || { echo "  $rn: a repo folder name with spaces or other characters, not listed: add it to repos.tsv by hand" >&2; continue; }
      url="$(git -C "$d" remote get-url origin 2>/dev/null || true)"; url_ok "$url" || url=-
      rows+=("$rn"$'\t'"$url"$'\t-\tno')
    done
  fi
  for r in ${repos[@]+"${repos[@]}"}; do
    url_ok "$r" || die "'$r' is not a git URL (https://, ssh://, git@host:path or a local path)"
    rn="$(basename "$r" .git)"; name_ok "$rn" || die "'$r' gives the repo name '$rn', which is not a plain folder name"
    printf '%s\n' ${rows[@]+"${rows[@]}"} | cut -f1 | grep -qxF "$rn" && die "two repos would both be named '$rn': clone one under another name and add it to repos.tsv by hand"
    rows+=("$rn"$'\t'"$r"$'\t-\tyes')
  done
  # Every folder the workspace will hold data in, for the backup check.
  local dd=("$ws") row
  [[ -n "$host" ]] && dd+=("$host")
  for row in ${rows[@]+"${rows[@]}"}; do
    d="$(printf '%s\n' "$row" | cut -f5)"; [[ -n "$d" ]] || d="$(printf '%s\n' "$row" | cut -f1)"
    case "$d" in /*) dd+=("$d") ;; *) dd+=("$ws/$d") ;; esac
  done
  check_backup_outside "${dd[@]}"
  # Around a folder, a file already at a kit path would be run as the kit's: refuse instead.
  if [[ "$layout" == around ]]; then
    local clash=() src dst
    while read -r src dst; do [[ -e "$ws/$dst" ]] && ! cmp -s "$KIT/$src" "$ws/$dst" && clash+=("$dst"); done < <(managed)
    ((${#clash[@]} == 0)) || die "these files already exist at paths the kit uses: ${clash[*]}. Rename or move them, then run cabinet init again."
  fi

  # --dry-run: everything this setup would write or change, then stop before touching anything.
  if ((dry)); then
    local f rel placed_n=0 kept_l=""
    echo "Dry run: $how would create the $layout workspace $name ($slug) at $ws, owner $owner <$email>."
    while IFS= read -r f; do
      rel="${f#"$KIT/templates/workspace/"}"; [[ "$rel" == gitignore ]] && rel=.gitignore
      [[ "$layout" == inside && "$visibility" == shared && -f "$host/package.json" && "$rel" == package.json ]] && continue
      if [[ -e "$ws/$rel" ]]; then kept_l+=" $rel"; else placed_n=$((placed_n + 1)); fi
    done < <(find "$KIT/templates/workspace" -type f)
    echo "  - write $placed_n project files (AGENTS.md, cabinet.env, HANDOFFS.md, OPERATIONS.md, roles/, jobs/, specs/, notes/, ...)"
    [[ -n "$kept_l" ]] && echo "  - keep, not replace:$kept_l"
    echo "  - copy $(managed | wc -l | tr -d ' ') kit files (CABINET.md, bin/, .cabinet/) and build the roles: $roles"
    if [[ "$layout" == inside && "$visibility" == private ]]; then
      echo "  - in the project: add cabinet/, the pointer files and the role files to .git/info/exclude; write the pointer to CLAUDE.local.md and QWEN.local.md (and AGENTS.md if the project has none); no tracked file changes"
    elif [[ "$layout" == inside ]]; then
      echo "  - in the project: add an Agent team section to its AGENTS.md (or CLAUDE.md) and pin @tarekraafat/cabinet in its package.json; commit nothing"
    fi
    ((${#rows[@]})) && echo "  - list the repos: $(printf '%s\n' "${rows[@]}" | cut -f1 | tr '\n' ' ')"
    if [[ "$layout" == inside && "$visibility" == shared ]] || [[ "$layout" == around && -e "$ws/.git" ]]; then echo "  - commit nothing (review and commit yourself)"
    elif [[ "$owner" == TBD || "$email" == TBD ]]; then echo "  - git init, but no commit (no owner identity yet)"
    else echo "  - git init and one commit as $owner"; fi
    echo "  - record the slug in $LOGROOT_SHOWN/$slug/workspace"
    echo "  Settings: runner $runner, brief ${brief:-off}, week starts $week, writing $writing, credit roles $credit${cemail:+ ($cemail)}, budget $( [[ -n "$budget" ]] && echo "\$$budget a week" || echo off), backups ${backup:-off}."
    echo "Nothing was written."
    return 0
  fi

  if ((tty)); then
    echo
    case "$layout" in
      inside) echo "  Workspace $ws ($visibility)" ;;
      beside) echo "  Workspace $ws, beside $host" ;;
      around) echo "  Workspace $ws, around what is there (nothing is replaced)" ;;
      new) echo "  Workspace $ws" ;;
    esac
    echo "  Project   $name ($slug)"
    echo "  Owner     $owner <$email>"
    [[ -n "$pkg_desc" ]] && echo "  About     $pkg_desc (from package.json)"
    ((${#pkg_scripts[@]})) && echo "  Scripts   $(printf '%s, ' "${pkg_scripts[@]}" | sed 's/, $//') (from package.json)"
    echo "  Roles     $roles"
    echo "  Runner    $runner${runner_cmd:+ ($runner_cmd)}, brief ${brief:-off}, week starts $week, writing $writing"
    echo "  Credit    roles credited on commits from Cabinet runs: $credit${cemail:+, as $cemail}"
    [[ -n "$budget" ]] && echo "  Budget    \$$budget a week${price:+, priced at $price per million tokens}"
    echo "  Backups   ${backup:-off}"
    local listed="none yet"; ((${#rows[@]})) && listed="$(printf '%s\n' "${rows[@]}" | cut -f1 | tr '\n' ' ')"
    echo "  Repos     $listed"
    confirm "Create it?" y || die "nothing created"
    echo
  fi

  # A setup that fails part way undoes what it made, so it can simply be run again: it
  # removes the folder it created, or empties the empty folder it was given (never more).
  if [[ "$layout" != around ]]; then
    [[ ! -e "$ws" ]] || [[ -z "$(ls -A "$ws")" ]] || die "$ws is no longer empty"
    SETUP_KEEP=0; [[ -d "$ws" ]] && SETUP_KEEP=1
    SETUP_WS="$ws" SETUP_HOST="$host"
    trap 'if [[ -n "${SETUP_WS:-}" ]]; then
            if ((SETUP_KEEP)); then find "$SETUP_WS" -mindepth 1 -delete 2>/dev/null; else rm -rf "$SETUP_WS"; fi
            echo "$ERR_TAG setup did not finish; undid $SETUP_WS" >&2
            [[ -n "${SETUP_HOST:-}" ]] && echo "$ERR_TAG check the project for lines setup may have added: the Agent team section in AGENTS.md, CLAUDE.local.md or QWEN.local.md, and cabinet entries in .git/info/exclude" >&2
          fi' EXIT
  fi
  mkdir -p "$ws"; ws="$(cd "$ws" && pwd -P)"; [[ -n "${SETUP_WS:-}" ]] && SETUP_WS="$ws"
  local had_git=0; [[ "$layout" == around && -e "$ws/.git" ]] && had_git=1
  # Shared inside a project with its own package.json: the pin goes there. Private
  # changes no tracked file of the project, so its pin stays in cabinet/package.json.
  local host_pkg=0; [[ "$layout" == inside && "$visibility" == shared && -f "$host/package.json" ]] && host_pkg=1

  echo "== Project files"
  local kept=()
  local f rel dst placed=" " Week="$(printf %s "${week:0:1}" | tr '[:lower:]' '[:upper:]')${week:1}"
  while IFS= read -r f; do
    rel="${f#"$KIT/templates/workspace/"}"
    [[ "$rel" == gitignore ]] && rel=.gitignore
    ((host_pkg)) && [[ "$rel" == package.json ]] && continue
    dst="$ws/$rel"
    if [[ -e "$dst" || -L "$dst" ]]; then kept+=("$rel"); continue; fi
    mkdir -p "$(dirname "$dst")"
    P="$name" S="$slug" O="$owner" E="$email" V="$VERSION" node "$LIBJS" fill-template "$f" > "$dst"
    placed+="$rel "
  done < <(find "$KIT/templates/workspace" -type f | sort)
  is_placed() { [[ "$placed" == *" $1 "* ]]; }

  # The answers, written into the files this setup placed (a kept file is the project's own).
  if is_placed cabinet.env; then
    R="$roles" N="$runner" C="$runner_cmd" B="$backup" U="$budget" P="$price" L="$layout" V="$([[ "$layout" == inside ]] && echo "$visibility")" node "$LIBJS" sub "$ws/cabinet.env" -- \
      '/^CABINET_ROLES=.*/' 'CABINET_ROLES="${R}"' '/^CABINET_RUNNER=.*/' 'CABINET_RUNNER="${N}"' \
      '/^CABINET_RUNNER_CMD=.*/' "CABINET_RUNNER_CMD='\${C}'" \
      '/^CABINET_BACKUP_DIR=.*/' 'CABINET_BACKUP_DIR="${B}"' '/^CABINET_BUDGET=.*/' 'CABINET_BUDGET="${U}"' '/^CABINET_PRICE=.*/' 'CABINET_PRICE="${P}"' \
      '/^CABINET_LAYOUT=.*/' 'CABINET_LAYOUT="${L}"' '/^CABINET_VISIBILITY=.*/' 'CABINET_VISIBILITY="${V}"'
    CR="$credit" CE="$cemail" node "$LIBJS" sub "$ws/cabinet.env" -- '/^CABINET_CREDIT_ROLES=.*/' 'CABINET_CREDIT_ROLES="${CR}"' '/^CABINET_CREDIT_EMAIL=.*/' 'CABINET_CREDIT_EMAIL="${CE}"'
    # Shared, each machine answers for itself (cabinet.local.env, never committed): this one just did.
    [[ "$layout" == inside && "$visibility" == shared ]] && printf 'CABINET_CREDIT_ROLES="%s"\n' "$credit" >> "$ws/cabinet.local.env"
  fi
  # The "Commits." house rule allows the role credit only while it is on.
  [[ "$credit" == on ]] && is_placed AGENTS.md && { node "$LIBJS" credit-line "$ws/AGENTS.md" on || true; }
  is_placed jobs/brief.job && W="$brief" node "$LIBJS" sub "$ws/jobs/brief.job" -- '/^WHEN=.*/' 'WHEN="${W}"'
  is_placed AGENTS.md && D="$Week" G="$writing" node "$LIBJS" sub "$ws/AGENTS.md" -- \
    '/^(- \*\*Week starts on:\*\*) \w+\./' '$1 ${D}.' '/^(- \*\*Writing to the owner:\*\*) \w+\./' '$1 ${G}.'
  # What the project already says, in place of the TBDs it answers. The rest stays TBD.
  if is_placed AGENTS.md && [[ -n "$host" ]]; then
    local hp=".."; [[ "$layout" == beside ]] && hp="$(printf '%s\n' "${rows[0]}" | cut -f5)"
    local about="" own="" t=""
    # Quoted as data: the project wrote it, the owner has not checked it.
    [[ -n "$pkg_desc" ]] && about="From \`$hp/package.json\`, as written there: \"$pkg_desc\""$'\n\n'
    for f in AGENTS.md CLAUDE.md README.md; do [[ -f "$host/$f" ]] && own+="\`$hp/$f\`, "; done
    [[ -n "$own" ]] && about+="The project's own rules and setup: ${own%, }."$'\n\n'
    about+="TBD: who it is for, and the words every agent must use (and never use) for it, written by the owner."
    if ((${#pkg_scripts[@]})); then
      t="The project's scripts, from \`$hp/package.json\`, run in \`$hp\`:"$'\n'
      for r in "${pkg_scripts[@]}"; do t+=$'\n'"- \`$r\`"; done
      t+=$'\n\n'"TBD: what else qa needs to run it locally (services, local database, test account), and what must never be touched (production, shared databases)."
    fi
    node "$LIBJS" replace-line "$ws/AGENTS.md" "TBD: one paragraph, written by the owner." "$about"
    node "$LIBJS" replace-line "$ws/AGENTS.md" "TBD: how qa runs the product locally" "$t"
  fi
  for r in $ROLES_ALL $ROLES_OPT; do
    has "$roles" "$r" && continue
    # A disabled role leaves the team tables.
    for f in AGENTS.md OPERATIONS.md; do is_placed "$f" && node "$LIBJS" drop-text "$ws/$f" "| $r |"; done
  done
  local row
  for row in ${rows[@]+"${rows[@]}"}; do
    rn="${row%%$'\t'*}"
    if [[ -f "$ws/repos.tsv" ]] && ! cut -f1 "$ws/repos.tsv" | grep -qxF "$rn"; then printf '%s\n' "$row" >> "$ws/repos.tsv"; fi
    is_placed AGENTS.md && node "$LIBJS" before "$ws/AGENTS.md" '/^\| workspace \(this folder\)/' "| \`$rn\` | TBD | TBD |"
  done
  echo "  placed: $(echo $placed | wc -w | tr -d ' ') files"
  ((${#kept[@]})) && echo "  kept your own (not replaced; merge by hand if you want the kit's): ${kept[*]}"

  echo "== Kit files"
  sync_kit "$ws" | grep -v '^  added' || true
  [[ -e "$ws/CLAUDE.md" || -L "$ws/CLAUDE.md" ]] || ln -s AGENTS.md "$ws/CLAUDE.md"

  # Inside a project, agents start in the project, so its instructions point them at the team.
  if [[ "$layout" == inside ]]; then
    local pointer="The agent team for this project works from \`cabinet/\`. Before any task that involves handoffs, specs, verdicts or the team's roles, read \`cabinet/CABINET.md\`, then \`cabinet/AGENTS.md\`. Their paths are relative to \`cabinet/\`."
    add_pointer() { grep -qF 'cabinet/CABINET.md' "$1" 2>/dev/null && return 0; [[ -s "$1" ]] && printf '\n' >> "$1"; printf '%s\n' "## Agent team" "" "$pointer" >> "$1"; }
    if [[ "$visibility" == private ]]; then
      # Private: bin/role.sh build (run next, and on every update and restore) keeps cabinet/ and
      # the pointers out of the project's git and writes them only into untracked files.
      if git -C "$host" ls-files --error-unmatch AGENTS.md >/dev/null 2>&1; then
        echo "  the project's AGENTS.md is its own and was left alone: Codex, opencode, Gemini and Cursor read only that file,"
        echo "  so start them in cabinet/, or add its \"Agent team\" section to AGENTS.md yourself"
      fi
      echo "  the project's git ignores cabinet/ and the pointers setup adds; no tracked file of the project changes"
    else
      local hf="$host/AGENTS.md"
      [[ ! -e "$hf" && -f "$host/CLAUDE.md" && ! -L "$host/CLAUDE.md" ]] && hf="$host/CLAUDE.md"
      add_pointer "$hf"; echo "  added an \"Agent team\" section to ${hf#"$host/"} pointing at cabinet/"
    fi
  fi
  "$ws/bin/role.sh" build
  [[ ! -f "$ws/OPERATIONS.md" ]] || "$ws/bin/manual.sh" build >/dev/null || echo "  OPERATIONS.html not built (bin/manual.sh build)"
  # Written last: a workspace with a version is a finished one.
  echo "$VERSION" > "$ws/.cabinet/version"

  # The workspace's own git, unless it already had one or lives in the project's (shared).
  # Only the files setup placed are staged: never something that was already in the folder.
  local committed=0 add=(.cabinet CLAUDE.md ORG.md agents .claude/agents) x
  for x in $placed; do add+=("$x"); done
  while read -r _ x; do add+=("$x"); done < <(managed)
  if [[ "$layout" == inside && "$visibility" == shared ]] || ((had_git)); then :
  else
    git -C "$ws" init -q -b main
    if [[ "$owner" != TBD && "$email" != TBD ]]; then
      # -f: these are setup's own files, even if the folder's own .gitignore covers their paths.
      git -C "$ws" add -f -- "${add[@]}" || echo "  could not stage the workspace's files: commit them yourself"
      git -C "$ws" -c commit.gpgsign=false -c user.name="$owner" -c user.email="$email" commit -q -m "workspace: create from cabinet $VERSION" 2>/dev/null && committed=1
    fi
  fi
  if ((committed)); then echo "== Committed the new workspace as $owner"
  elif ((had_git)) || [[ "$visibility" == shared ]]; then echo "== Not committed: review the new files and commit them yourself"
  else echo "== Not committed: no owner name and email yet (cabinet config --owner ... --email ..., then commit)"; fi
  SETUP_WS=""   # finished: nothing to clean up
  claim_slug "$slug" "$ws"

  # The version pin: a devDependency in the project's package.json (inside), or in the
  # workspace's own (placed from the template). Written with npm's own editor, no network.
  local pinned=0 installed=0 setup=0 pinat="$ws"
  ((host_pkg)) && pinat="$host"
  if [[ -f "$pinat/package.json" ]] && json -e '[$.devDependencies, $.dependencies].some((d) => Object.hasOwn(obj(d), "@tarekraafat/cabinet"))' "$pinat/package.json" >/dev/null 2>&1; then
    pinned=1
  elif ((host_pkg)); then
    if command -v npm >/dev/null && (cd "$host" && npm pkg set "devDependencies[@tarekraafat/cabinet]=^$VERSION"); then
      pinned=1; echo "  added @tarekraafat/cabinet ^$VERSION to the project's devDependencies"
    else
      echo "  could not add the pin to package.json: add \"@tarekraafat/cabinet\": \"^$VERSION\" to its devDependencies"
    fi
  fi
  [[ -d "$pinat/node_modules/@tarekraafat/cabinet" ]] && installed=1
  if ((tty)) && ((pinned)) && ((installed == 0)); then
    echo
    if confirm "Download the pinned kit now (npm install in $([[ "$pinat" == "$host" ]] && echo "the project" || echo "the workspace"))?" y; then
      (cd "$pinat" && npm install --no-audit --no-fund) && installed=1 \
        || echo "  npm install failed: check that you can reach the package's registry, then run it in $pinat."
    fi
  fi
  if ((tty)); then
    if confirm "Set up this machine now (clone repos, guardrails, schedules)? It shows the changes first." n; then
      "$ws/bin/bootstrap.sh" --dry-run
      confirm "Apply these changes?" n && "$ws/bin/bootstrap.sh" && setup=1
    fi
  fi

  echo
  echo "Created $name at $ws (slug $slug, cabinet $VERSION)."
  echo "Next:"
  echo "  - Fill the TBDs in $([[ "$layout" == inside ]] && echo cabinet/)AGENTS.md: what $name is, its product rules, how to test, the repo rows."
  ((installed)) || ((pinned == 0)) || echo "  - In $pinat: npm install (downloads the pinned kit and locks its version)."
  ((setup)) || echo "  - Set up this machine: cabinet bootstrap --dry-run, then cabinet bootstrap."
  echo "  - cabinet next shows what is left, at any time, from anywhere in $ws."
  echo "Updates: npm update, then cabinet update (npx cabinet update without a global install)."
}

# Change a workspace's settings after setup: the same questions, with its current
# answers as defaults. Writes the files, keeps the team tables in step, runs
# bin/role.sh build, and (asked, or with --apply) bin/bootstrap.sh for schedules and repos.
# A new slug stops the old schedules first. Layout and visibility are not changed here.
# cabinet role add|remove|list|draft|build. Add turns on a kit role, or makes a role of the project's
# own, roles/<role>.md, from what the owner knows (as little as its name), registered through config
# like any role and then drafted by an agent ("Drafting a role", .cabinet/rules/seats.md). Remove turns one off.
ask_free() { local a=""; read -r -u 3 -p "  $1: " a || true; printf '%s' "$a"; }
cmd_role() {
  local sub="${1:-}"; (($#)) && shift
  case "$sub" in
    add|remove) ;;
    list|draft|build) ws_script role.sh "$sub" "$@" ;;
    "") cmd_help role; exit 0 ;;
    *) echo "$ERR_TAG unknown command 'role $sub'" >&2; cmd_help role >&2; exit 2 ;;
  esac
  local name="" does="" owns="" decides="" escalates="" lead="" covers="" title="" dname="" func="" draft=0 yes=0 dry=0
  while (($#)); do
    case "$1" in
      --does|--owns|--decides|--escalates|--reports-to|--covers|--title|--name|--function)
        (($# >= 2)) || die "$1 needs a value"
        case "$1" in --does) does="$2" ;; --owns) owns="$2" ;; --decides) decides="$2" ;; --escalates) escalates="$2" ;; --reports-to) lead="$2" ;;
          --covers) covers="$2" ;; --title) title="$2" ;; --name) dname="$2" ;; *) func="$2" ;; esac
        shift 2 ;;
      --draft) draft=1; shift ;;
      --dry-run) dry=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -*) bad_usage "unknown option $1 (see: cabinet role $sub --help)" ;;
      *) [[ -z "$name" ]] || die "one role name at a time"; name="$1"; shift ;;
    esac
  done
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || bad_usage "usage: cabinet role $sub <name>: lowercase letters, digits and dashes, starting with a letter, like brand-designer"
  local ws; ws="$(need_ws)" || exit 1
  # Title, display name and function: plain words, one line each, into the role's Team section.
  local v
  for v in "$title" "$dname" "$func"; do [[ "$v" =~ ^[A-Za-z0-9][A-Za-z0-9\ \'.,\&/-]*$ || -z "$v" ]] || die "'$v': a title, name or function is plain words (letters, digits, spaces and . , ' & / -)"; done
  team_lines() {  # the Team section for a role: its lead, what it covers, its trial, its title, name, function
    [[ -n "$lead$title$dname$func" ]] || return 0
    printf '\n## Team\n\n'
    [[ -z "$lead" ]] || printf -- '- Reports to: %s\n' "$lead"
    [[ -z "$covers" ]] || printf -- '- Covers: %s\n' "${covers// /, }"
    [[ -z "$lead" ]] || printf -- '- Trial until: %s\n' "$(epoch_date $(( $(date +%s) + 30 * 86400 )) +%F)"
    [[ -z "$title" ]] || printf -- '- Title: %s\n' "$title"
    [[ -z "$dname" ]] || printf -- '- Name: %s\n' "$dname"
    [[ -z "$func" ]] || printf -- '- Function: %s\n' "$func"
  }
  has "backend web mobile infrastructure" "$name" && die "$name is a kit builder: it comes with the repos it owns in the team table of AGENTS.md (change a repo's row to change its builder)"
  local cur runner; cur="$( ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${CABINET_ROLES:-}" ) )"
  runner="$( ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${CABINET_RUNNER:-claude}" ) )"
  local dryflag=(); ((dry)) && dryflag=(--dry-run)
  # A role change is committed when the workspace has its own git and the files it touches held no
  # edits of the owner's before; otherwise the owner reviews and commits it, as after cabinet config.
  local team_paths=(AGENTS.md OPERATIONS.md ORG.md cabinet.env roles agents .claude/agents)
  local team_clean=0
  [[ "$(cd "$(git -C "$ws" rev-parse --show-toplevel 2>/dev/null || echo /nonexistent)" 2>/dev/null && pwd -P)" == "$(cd "$ws" && pwd -P)" &&
     -z "$(git -C "$ws" status --porcelain -- "${team_paths[@]}" 2>/dev/null)" ]] && team_clean=1
  team_commit() {  # team_commit <message>
    local f
    local files=()
    while IFS= read -r f; do files+=("$f"); done < <(git -C "$ws" status --porcelain -- "${team_paths[@]}" 2>/dev/null | cut -c4-)
    if ((team_clean)) && ((${#files[@]})) && git -C "$ws" add -A -- "${files[@]}" 2>/dev/null &&
       git -C "$ws" -c commit.gpgsign=false commit -q -m "$1" -- "${files[@]}" >/dev/null 2>&1; then
      echo "Committed in the workspace: $1"
    else
      echo "Review with git -C \"$ws\" diff, then commit."
    fi
  }
  if [[ "$sub" == remove ]]; then
    [[ -z "$does$owns$decides$escalates$lead$covers$title$dname$func" ]] && ((draft == 0)) || bad_usage "role remove takes only a name (and --dry-run)"
    [[ "$name" == chief-of-staff ]] && die "chief-of-staff is always on: it writes the brief and routes work"
    has "$cur" "$name" || die "$name is not on the team (cabinet role list)"
    CABINET_NO_COMMIT=1 "$KIT/bin/cabinet" -C "$ws" config --yes --roles "$(printf '%s\n' $cur | grep -vxF "$name" | tr '\n' ' ')" "${dryflag[@]+"${dryflag[@]}"}" >/dev/null || die "could not turn $name off (see above)"
    ((dry)) && { echo "would turn $name off: its built files and its rows in the team tables go$([[ -f "$ws/roles/$name.md" ]] && echo "; roles/$name.md stays")"; return 0; }
    echo "Turned $name off: its built files and its rows in the team tables are gone.$([[ -f "$ws/roles/$name.md" ]] && echo " roles/$name.md stays; delete it to drop the role for good.")"
    echo "bin/doctor.sh notes any open handoff still addressed to it."
    team_commit "roles: $name off"
    return 0
  fi
  has "$cur" "$name" && die "$name is already on the team (cabinet role list)"
  if has "$ROLES_ALL $ROLES_OPT" "$name"; then
    # A kit role: turn it on, with its rows in the team tables.
    [[ -z "$does$owns$decides$escalates$lead$covers" ]] && ((draft == 0)) || bad_usage "$name is a kit role: it needs no brief, only --title, --name or --function (add project notes in roles/$name.md, without frontmatter)"
    [[ -z "$title$dname$func" || ! -f "$ws/roles/$name.md" ]] || ! grep -qx '## Team' "$ws/roles/$name.md" || die "roles/$name.md has a Team section already: edit its title there"
    if ((dry == 0)) && [[ -n "$title$dname$func" ]]; then
      mkdir -p "$ws/roles"
      if [[ -s "$ws/roles/$name.md" ]]; then team_lines; else team_lines | sed '1{/^$/d;}'; fi >> "$ws/roles/$name.md"
    fi
    CABINET_NO_COMMIT=1 "$KIT/bin/cabinet" -C "$ws" config --yes --roles "$cur $name" "${dryflag[@]+"${dryflag[@]}"}" >/dev/null || die "could not turn $name on (see above)"
    ((dry)) && { echo "would turn on the kit role $name, with its rows in the team tables"; return 0; }
    echo "Turned on the kit role $name, with its rows in the team tables of AGENTS.md and OPERATIONS.md."
    team_commit "roles: $name on"
    return 0
  fi
  [[ -e "$ws/roles/$name.md" ]] && die "roles/$name.md exists: turn it on with cabinet config --roles, or redraft it with cabinet role draft $name"
  # What it owns, against the team table (CABINET.md, "Ownership"): a path, or a repo's name, that is
  # another role's row is refused; one inside another role's area becomes the new role's own row when
  # it is drafted (the most specific row wins), so it is only said. Read with the workspace's own
  # scripts; an older kit skips it.
  owns_check() {
    [[ -n "$owns" ]] || return 0
    local found taken inside
    found="$(bash -c 'set -f; source "$1/bin/lib.sh" 2>/dev/null && declare -F team_rows >/dev/null || exit 0
      names=" $(repos 2>/dev/null | cut -f1 | tr "\n" " ") "
      for t in $(printf "%s" "$2" | tr ",;()" "    "); do
        t="${t//\`/}"; t="${t%[.:]}"
        [[ "$t" == */* || "$names" == *" $t "* ]] || continue
        t="${t%/}"
        best="" who=""
        while IFS=$(printf "\t") read -r a o; do
          if [[ "$t" == "$a" || "$t" == "$a/"* ]] && (( ${#a} > ${#best} )); then best="$a" who="$o"; fi
        done < <(team_rows)
        [[ -n "$who" && "$who" != "$3" ]] || continue
        [[ "$best" == "$t" ]] && printf "taken %s (%s)\n" "$t" "$who" || printf "inside %s (inside %s, %s)\n" "$t" "$best" "$who"
      done; exit 0' _ "$ws" "$owns" "$name")"
    taken="$(sed -n 's/^taken //p' <<<"$found" | paste -sd ';' - | sed 's/;/; /g')"
    inside="$(sed -n 's/^inside //p' <<<"$found" | paste -sd ';' - | sed 's/;/; /g')"
    [[ -z "$taken" ]] || die "the team table of AGENTS.md gives $taken to another role: own a narrower path, or change that row first (one owner for each area)"
    [[ -z "$inside" ]] || echo "Note: $inside: drafting gives $name its own row there, and the most specific row wins (CABINET.md, \"Ownership\")." >&2
  }
  owns_check
  # A sub-team role: its lead is on the team, and what it covers is builders or repos (seats.md, "Sub-teams").
  [[ -n "$lead" || -z "$covers" ]] || die "--covers goes with --reports-to: a role covers work for its lead"
  if [[ -n "$lead" ]]; then
    [[ "$lead" =~ ^[a-z][a-z0-9-]*$ && "$lead" != "$name" ]] || die "--reports-to needs another role's name"
    has "$cur backend web mobile infrastructure" "$lead" || die "$lead is not on the team (cabinet role list)"
    covers="$(printf '%s' "$covers" | tr ',' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')"
    local bad
    bad="$(bash -c 'source "$1/bin/lib.sh" 2>/dev/null && declare -F builds_repos >/dev/null || exit 0
      for c in $2; do [[ "$c" =~ ^[a-z0-9._-]+$ ]] && builds_repos "$c" || printf "%s " "$c"; done' _ "$ws" "$covers")"
    [[ -z "$bad" ]] || die "--covers takes builders or repos whose work the role reviews for $lead: ${bad% } is neither (cabinet repo list, cabinet role list)"
  fi
  if ((dry)); then echo "would write roles/$name.md from your brief and turn $name on, with rows in the team tables"; return 0; fi
  local tty=0
  if ((yes == 0)) && [[ -z "$does$owns$decides$escalates" ]] && { exec 3<"${CABINET_TTY:-/dev/tty}"; } 2>/dev/null; then tty=1; fi
  if ((tty)); then
    echo "A new role: $name. Say what you know; Enter leaves it to the agent that drafts the role from what the project shows."
    does="$(ask_free "What should it do")"; owns="$(ask_free "What does it own (repos, folders, areas)")"
    decides="$(ask_free "What may it decide on its own")"; escalates="$(ask_free "What must it bring to you")"
    owns_check
  fi
  # The owner's words, one line each, kept as data in the role file.
  said() { local v; v="$(printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/  */ /g; s/^ //; s/ $//')"; printf '%s' "${v:-not said yet}"; }
  mkdir -p "$ws/roles"
  cat > "$ws/roles/$name.md" <<ROLE
---
name: $name
description: TBD: what this role does and when to use it, drafted from the owner's brief below (cabinet role draft $name).
tools: Read, Grep, Glob, Bash, Edit, Write
---

You are the $(printf %s "$name" | tr - ' ') for this project. This role is not drafted yet: until it is, do only what the owner's brief below asks, write only where it says, and bring every decision to the owner.

Read \`CABINET.md\`, then \`AGENTS.md\`. Every rule in them applies to you.

## The owner's brief

What the owner said this role is for, kept word for word. It wins over anything drafted from it. Add to it at any time, then redraft: \`cabinet role draft $name\`.

- What it should do: $(said "$does")
- What it owns: $(said "$owns")
- What it may decide on its own: $(said "$decides")
- What it must bring to the owner: $(said "$escalates")
ROLE
  team_lines >> "$ws/roles/$name.md"
  CABINET_NO_COMMIT=1 "$KIT/bin/cabinet" -C "$ws" config --yes --roles "$cur $name" >/dev/null || { rm -f "$ws/roles/$name.md"; die "could not add $name to the team (see above)"; }
  echo "Added the $name role: roles/$name.md, and its rows in AGENTS.md and OPERATIONS.md."
  team_commit "roles: $name added from the owner's brief"
  if ((draft == 0 && tty)); then confirm "Draft it now with $runner? It runs your agent tool for a few minutes, which may cost money" n && draft=1; fi
  ((draft)) && exec "$ws/bin/role.sh" draft "$name"
  echo "Next, draft it from your brief and the project: in your agent session, ask to \"draft the $name role\" (CABINET.md, \"Drafting a role\"),"
  echo "or run cabinet role draft $name. Until then the doctor reminds you."
}

# "Hard to undo" in AGENTS.md: paths a small task never touches (.cabinet/rules/ready-to-build.md).
# hard_now <ws>: the paths listed, space separated; "off" when it says "- none"; empty when not set.
hard_now() {
  local l
  l="$(awk '/^## / {h = ($0 == "## Hard to undo"); next} h && /^- /' "$1/AGENTS.md" 2>/dev/null)"   # the list, not the prose
  if grep -q '`' <<<"$l"; then grep -o '`[^`]*`' <<<"$l" | tr -d '`' | paste -sd ' ' -
  elif grep -qx -- '- none' <<<"$l"; then echo off; fi
}
# hard_dirs <ws>: "<repo>\t<folder>" for every repo in repos.tsv.
hard_dirs() {
  awk -F'\t' -v OFS='\t' '{ sub(/\r$/, "") } !/^#/ && NF >= 2 { print $1, ($5 == "" ? $1 : $5) }' "$1/repos.tsv" 2>/dev/null \
    | while IFS=$'\t' read -r n p; do case "$p" in /*) ;; "~/"*) p="$HOME/${p#"~/"}" ;; *) p="$1/$p" ;; esac; printf '%s\t%s\n' "$n" "$p"; done
}
# hard_guesses <ws>: paths in the repos on this machine that look hard to undo, for the owner to confirm.
hard_guesses() {
  local n d p
  while IFS=$'\t' read -r n d; do
    [[ -d "$d" ]] || continue
    for p in migrations/ db/migrate/ prisma/migrations/ supabase/migrations/ alembic/versions/ openapi.yaml openapi.yml openapi.json; do
      [[ -e "$d/${p%/}" ]] && printf '%s/%s ' "$n" "$p"
    done
  done < <(hard_dirs "$1")
  return 0
}
# hard_check <ws> <paths>: each is <repo>/<path> in safe characters, for a repo in repos.tsv, and exists
# there when the repo is on this machine.
hard_check() {
  local x n p d
  for x in $2; do
    [[ "$x" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$ && "/$x/" != *"/../"* ]] || die "'$x' is not <repo>/<path> (letters, digits, . _ - and /), like api/migrations/"
    n="${x%%/*}" p="${x#*/}"
    d="$(hard_dirs "$1" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')"
    [[ -n "$d" ]] || die "'$x': no repo named $n in repos.tsv (cabinet repo list)"
    [[ ! -d "$d" || -e "$d/${p%/}" ]] || die "'$x': $n has no ${p%/} (check the path; a folder ends with /)"
  done
}
# hard_write <ws> <paths|off>: set the list under "Hard to undo", keeping the section's other lines;
# a missing section is added before "House rules". Written only when the result is whole.
hard_write() {
  node "$KIT/scripts/lib.js" hard-write "$1/AGENTS.md" $2
}

cmd_config() {
  local dirarg="" yes=0 apply=0 extra_roles="" dry=0 this_machine=0 clear=0
  local name="" slug="" owner="" email="" roles="" runner="" runner_cmd="" brief="" week="" backup="" backup_time="" budget="" price="" writing="" repos=()
  local hard="" set_hard=0 o_hard pipe="" plimit="" ptime="" set_pipe=0 set_plimit=0 set_ptime=0 o_pipe o_plimit o_ptime
  local credit="" cemail="" set_credit=0 cemail_given=0
  local set_price=0 set_writing=0 set_name=0 set_slug=0 set_owner=0 set_email=0 set_roles=0 set_runner=0 set_cmd=0 set_brief=0 set_week=0 set_backup=0 set_btime=0 set_budget=0
  while (($#)); do
    case "$1" in
      --name) need "--name needs a value" "$@"; name="$2"; set_name=1; shift 2 ;;
      --slug) need "--slug needs a value" "$@"; slug="$2"; set_slug=1; shift 2 ;;
      --owner) need "--owner needs a value" "$@"; owner="$2"; set_owner=1; shift 2 ;;
      --email) need "--email needs a value" "$@"; email="$2"; set_email=1; shift 2 ;;
      --roles) need "--roles needs a value" "$@"; roles="$2"; set_roles=1; shift 2 ;;
      --runner) need "--runner needs a value" "$@"; runner="$2"; set_runner=1; shift 2 ;;
      --runner-cmd) need "--runner-cmd needs a command" "$@"; runner_cmd="$2"; set_cmd=1; shift 2 ;;
      --brief-time) need "--brief-time needs a time, like 7 AM, or off" "$@"; brief="$2"; set_brief=1; shift 2 ;;
      --week-start) need "--week-start needs a day" "$@"; week="$2"; set_week=1; shift 2 ;;
      --writing) need "--writing needs short or standard" "$@"; writing="$2"; set_writing=1; shift 2 ;;
      --credit-roles) need "--credit-roles needs off or on" "$@"; credit="$2"; set_credit=1; shift 2 ;;
      --credit-email) need "--credit-email needs an email, or off" "$@"; cemail="$2"; cemail_given=1; shift 2 ;;
      --pipeline) need "--pipeline needs off, small or all" "$@"; pipe="$2"; set_pipe=1; shift 2 ;;
      --pipeline-limit) need "--pipeline-limit needs dollars, like 5" "$@"; plimit="$2"; set_plimit=1; shift 2 ;;
      --pipeline-time) need "--pipeline-time needs a time, like 10 PM, or off" "$@"; ptime="$2"; set_ptime=1; shift 2 ;;
      --hard-to-undo) need "--hard-to-undo needs paths like \"api/migrations/ api/openapi.yaml\", or off" "$@"; hard="$2"; set_hard=1; shift 2 ;;
      --backup-dir) need "--backup-dir needs a folder" "$@"; backup="$2"; set_backup=1; shift 2 ;;
      --backup-time) need "--backup-time needs a time, like 1 PM" "$@"; backup_time="$2"; set_btime=1; shift 2 ;;
      --budget) need "--budget needs dollars a week, like 20, or off" "$@"; budget="$2"; set_budget=1; shift 2 ;;
      --price) need "--price needs dollars per million tokens, like \"1.25 10\", or off" "$@"; price="$2"; set_price=1; shift 2 ;;
      --repo) need "--repo needs a git URL" "$@"; repos+=("$2"); shift 2 ;;
      --apply) apply=1; shift ;;
      --this-machine) this_machine=1; shift ;;
      --clear) clear=1; shift ;;
      --dry-run) dry=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -*) bad_usage "unknown option $1 (see: cabinet config --help)" ;;
      *) bad_usage "unexpected argument '$1' (to name a workspace: cabinet -C <dir> config)" ;;
    esac
  done
  if ((this_machine)); then
    # Only the backup settings and the credit roles answer are per machine; the rest is shared by every machine.
    (( set_name || set_slug || set_owner || set_email || set_roles || set_runner || set_cmd || set_brief || set_week || set_writing || set_hard || set_pipe || set_plimit || set_ptime || set_budget || set_price || cemail_given || ${#repos[@]} )) \
      && die "--this-machine sets only --backup-dir, --backup-time and --credit-roles: the other settings are shared by every machine"
    (( set_backup || set_btime || clear || set_credit )) || die "--this-machine needs --backup-dir <folder>|off, --backup-time <time>, --credit-roles off|on, or --clear"
    (( clear && set_credit )) && die "--clear cannot be combined with --credit-roles"
    (( clear && (set_backup || set_btime) )) && die "--clear cannot be combined with --backup-dir or --backup-time"
    yes=1
  else
    ((clear == 0)) || die "--clear goes with --this-machine"
  fi
  local ws; ws="$(find_ws "$dirarg")"
  [[ -f "$ws/.cabinet/version" && -f "$ws/cabinet.env" ]] || die "$ws is not a cabinet workspace"

  # Current answers, read from the files setup wrote.
  envget() { ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${!1:-}" ); }
  local o_name o_slug o_owner o_email o_roles o_runner o_cmd o_brief o_week o_backup o_btime o_budget o_price o_writing
  o_name="$(envget CABINET_PROJECT)"; o_slug="$(envget CABINET_SLUG)"
  o_roles="$(envget CABINET_ROLES)"; o_runner="$(envget CABINET_RUNNER)"; o_runner="${o_runner:-claude}"; o_cmd="$(envget CABINET_RUNNER_CMD)"
  o_budget="$(envget CABINET_BUDGET)"; o_price="$(envget CABINET_PRICE)"
  o_backup="$(envget CABINET_BACKUP_DIR)"; o_btime="$(envget CABINET_BACKUP_TIME)"; o_btime="${o_btime:-1:00 PM}"; o_btime="$(when_time_only "$o_btime" || printf '%s' "$o_btime")"
  o_owner="$(sed -n 's/^- \*\*Commits\.\*\* Authored as \(.*\) <\([^>]*\)>\..*/\1/p' "$ws/AGENTS.md" 2>/dev/null | head -1)"
  o_email="$(sed -n 's/^- \*\*Commits\.\*\* Authored as \(.*\) <\([^>]*\)>\..*/\2/p' "$ws/AGENTS.md" 2>/dev/null | head -1)"
  o_week="$(sed -n 's/^- \*\*Week starts on:\*\* \([A-Za-z]*\)\..*/\1/p' "$ws/AGENTS.md" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]')"
  o_writing="$(sed -n 's/^- \*\*Writing to the owner:\*\* \([A-Za-z]*\)\..*/\1/p' "$ws/AGENTS.md" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]')"
  o_brief="$( [[ -f "$ws/jobs/brief.job" ]] && (WHEN=""; source "$ws/jobs/brief.job" >/dev/null 2>&1; printf '%s' "$WHEN") )"
  [[ -z "$o_brief" ]] || o_brief="$(when_norm "$o_brief" || printf '%s' "$o_brief")"   # "daily 07:00" is "7:00 AM": no change
  ((set_name)) || name="$o_name"; ((set_slug)) || slug="$o_slug"; ((set_owner)) || owner="$o_owner"; ((set_email)) || email="$o_email"
  ((set_roles)) || roles="$o_roles"; ((set_runner)) || runner="$o_runner"; ((set_cmd)) || runner_cmd="$o_cmd"
  ((set_brief)) || brief="${o_brief:-off}"; ((set_week)) || week="${o_week:-sunday}"
  ((set_writing)) || writing="${o_writing:-standard}"
  o_hard="$(hard_now "$ws")"; ((set_hard)) || hard="$o_hard"
  # Credit roles: this machine's answer, as written: cabinet.local.env's line, else cabinet.env's, except in a
  # shared workspace, where each machine answers for itself. Nothing is set until it is answered (--yes keeps it).
  local lenv="$ws/cabinet.local.env" shared=0 o_credit="" o_credit_set=0 o_cfile="" o_cfile_set=0 o_cemail credit_bad=0
  lhas() { grep -q "^$1=" "$lenv" 2>/dev/null; }
  lget() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$lenv" 2>/dev/null | tail -1 || true; }
  [[ "$(envget CABINET_LAYOUT)" == inside && "$(envget CABINET_VISIBILITY)" == shared ]] && shared=1
  if grep -q '^CABINET_CREDIT_ROLES=' "$ws/cabinet.env"; then o_cfile="$(envget CABINET_CREDIT_ROLES)"; o_cfile_set=1; fi
  if lhas CABINET_CREDIT_ROLES; then o_credit="$(lget CABINET_CREDIT_ROLES)"; o_credit_set=1
  elif ((shared == 0 && o_cfile_set)); then o_credit="$o_cfile"; o_credit_set=1; fi
  o_cemail="$(envget CABINET_CREDIT_EMAIL)"
  if ((o_credit_set)) && [[ "$o_credit" != off && "$o_credit" != on ]]; then credit_bad=1; fi
  local credit_offer=on
  ((o_credit_set)) && credit_offer="$o_credit"; ((credit_bad)) && credit_offer=off; ((set_credit)) && credit_offer="$credit"
  o_pipe="$(envget CABINET_PIPELINE)"; o_pipe="${o_pipe:-off}"; o_plimit="$(envget CABINET_PIPELINE_LIMIT)"
  o_ptime=""   # empty: no pipeline job yet; off: one that runs only by hand
  if [[ -f "$ws/jobs/pipeline.job" ]]; then
    o_ptime="$(WHEN=""; source "$ws/jobs/pipeline.job" >/dev/null 2>&1; printf '%s' "$WHEN")"
    if [[ -n "$o_ptime" ]]; then o_ptime="$(when_norm "$o_ptime" || printf '%s' "$o_ptime")"; else o_ptime=off; fi
  fi
  ((set_pipe)) || pipe="$o_pipe"; ((set_plimit)) || plimit="$o_plimit"; ((set_ptime)) || ptime="${o_ptime:-10:00 PM}"
  ((set_backup)) || backup="${o_backup:-off}"; ((set_btime)) || backup_time="$o_btime"; ((set_budget)) || budget="$o_budget"; ((set_price)) || price="$o_price"
  # Roles this project defines itself (roles/<role>.md) count as known roles too.
  local r2
  # A file whose name is not a role name is never a role (its name would reach cabinet.env).
  for r2 in $o_roles; do role_ok "$r2" || continue; has "$ROLES_ALL $ROLES_OPT" "$r2" || { [[ -f "$ws/roles/$r2.md" ]] && extra_roles+="$r2 "; }; done
  for r2 in "$ws"/roles/*.md; do
    r2="$(basename "$r2" .md)"; [[ -f "$ws/roles/$r2.md" && "$r2" != README ]] || continue
    role_ok "$r2" || { echo "Note: roles/$r2.md is not a role: a role's file name is lowercase letters, digits and dashes. Rename it to use it." >&2; continue; }
    has "$ROLES_ALL $ROLES_OPT $extra_roles" "$r2" || { head -1 "$ws/roles/$r2.md" | grep -qx -- '---' && extra_roles+="$r2 "; }
  done
  extra_roles="${extra_roles% }"

  local tty=0 r
  if ((yes == 0)) && { exec 3<"${CABINET_TTY:-/dev/tty}"; } 2>/dev/null; then tty=1; fi
  if ((tty)); then
    echo "Settings for $o_name ($ws). Press Enter to keep the current value in brackets."
    echo
    name="$(ask "Project name" "$name")"
    echo "  The slug names this workspace's schedules, logs and backup key. Changing it moves them to the new name."
    slug="$(ask "Slug" "$slug")"
    owner="$(ask "Owner name (commit author)" "$owner")"
    email="$(ask "Owner email" "$email")"
    echo "  Roles. chief-of-staff is always on: it writes the brief and routes work."
    local picked="chief-of-staff"
    for r in ${ROLES_ALL#chief-of-staff } $ROLES_OPT $extra_roles; do
      confirm "  $r" "$(has "$roles" "$r" && echo y || echo n)" && picked+=" $r"
    done
    roles="$picked"
    runner="$(ask "Agent tool for scheduled jobs (${RUNNERS// /, }, or custom)" "$runner")"
    [[ "$(printf %s "$runner" | tr '[:upper:]' '[:lower:]')" == custom ]] && runner_cmd="$(ask "Command, with the prompt as \"\$CABINET_PROMPT\"" "$runner_cmd")"
    ask_budget
    echo "  The scheduled runner moves ready work through build and review while you are away, within a cost limit per run:"
    echo "  off, small (only small tasks) or all (small tasks and ready specs). It runs agents unattended."
    pipe="$(ask "Scheduled runner" "$pipe")"
    if [[ "$(printf %s "$pipe" | tr '[:upper:]' '[:lower:]')" != off ]]; then
      plimit="$(ask "Cost limit for one run, in US dollars" "${plimit:-5}")"
      ptime="$(ask "When it runs: a time every day (10 PM), days and a time, or off for by hand only" "$ptime")"
    fi
    brief="$(ask "Brief time: a time every day (7 AM), days and a time (fri 4 PM, sun,mon,tue,wed,thu 8 AM), or off" "$brief")"
    week="$(ask "Week starts on" "$week")"
    echo "  How agents write to you: standard, or short (the shortest briefs, questions and answers, for little time to read)."
    writing="$(ask "Writing" "$writing")"
    local cnote=""
    ((credit_bad)) && cnote="Now: \"$o_credit\", which is not off or on, so nothing is credited."
    ((shared && !o_credit_set)) && cnote="This machine has not answered yet: its runs credit nothing until it does."
    credit="$credit_offer"; credit_question "$cnote"; credit="$(printf %s "$credit" | tr '[:upper:]' '[:lower:]')"; set_credit=1
    local guess; guess="$(hard_guesses "$ws")"; guess="${guess% }"
    echo "  Paths where a change is hard to undo (migrations, public API files): a small task never touches them. <repo>/<path>, space separated, or off.${guess:+ Found in the repos: $guess}"
    hard="$(ask "Hard to undo" "${hard:-$guess}")"
    backup="$(ask "Backup folder (outside the workspace and its repos), or off" "$backup")"
    [[ "$backup" != off ]] && backup_time="$(ask "Backup time, like 1 PM" "$backup_time")"
    echo "  Repos now: $(grep -v '^#' "$ws/repos.tsv" 2>/dev/null | cut -f1 | tr '\n' ' ')"
    echo "  Add product repos: one git URL at a time, Enter on an empty line when done. To remove one, edit repos.tsv."
    while r="$(ask "Repo URL" "")"; [[ -n "$r" ]]; do repos+=("$r"); done
  fi

  [[ "$backup" == off || -z "$backup" ]] && backup="" || backup="$(abspath "$backup")"
  [[ "$(printf %s "$brief" | tr '[:upper:]' '[:lower:]')" == off ]] && brief=""
  week="$(printf %s "$week" | tr '[:upper:]' '[:lower:]')"
  writing="$(printf %s "$writing" | tr '[:upper:]' '[:lower:]')"
  hard="$(printf %s "$hard" | tr -s ' \t' '  ' | sed 's/^ //; s/ $//')"
  [[ "$(printf %s "$hard" | tr '[:upper:]' '[:lower:]')" == off ]] && hard=off
  [[ "$hard" == off || "$hard" == "$o_hard" ]] || hard_check "$ws" "$hard"
  # Every value written back in double quotes, given now or carried over, before any other check.
  env_ok CABINET_PROJECT "$name"; env_ok CABINET_SLUG "$slug"; env_ok CABINET_ROLES "$roles"; env_ok CABINET_RUNNER "$runner"
  env_ok CABINET_BACKUP_DIR "$backup"; env_ok CABINET_BACKUP_TIME "$backup_time"; env_ok CABINET_BUDGET "$budget"; env_ok CABINET_PRICE "$price"
  env_ok CABINET_PIPELINE "$pipe"; env_ok CABINET_PIPELINE_LIMIT "$plimit"
  env_ok CABINET_CREDIT_ROLES "$( ((set_credit)) && printf %s "$credit" || printf %s "$o_cfile")"
  env_ok CABINET_CREDIT_EMAIL "$( ((cemail_given)) && printf %s "$cemail" || printf %s "$o_cemail")"
  env_ok "WHEN in jobs/brief.job" "$brief"; env_ok "WHEN in jobs/pipeline.job" "$ptime"
  # The scheduled runner: off by default, and never on without a cost limit it can hold (runners as
  # SPEND_DOLLARS and SPEND_TOKENS in lib.sh say).
  pipe="$(printf %s "$pipe" | tr '[:upper:]' '[:lower:]')"
  has "off small all" "$pipe" || die "--pipeline must be off, small or all"
  [[ -z "$plimit" || "$plimit" =~ ^[0-9]+(\.[0-9]{1,2})?$ && ! "$plimit" =~ ^0+(\.0*)?$ ]] || die "the pipeline's cost limit must be dollars for one run, like 5 or 2.50"
  [[ "$pipe" == off || -n "$plimit" ]] || die "the scheduled runner needs a cost limit for one run: --pipeline-limit <dollars>"
  [[ "$pipe" == off ]] || { r="$(printf %s "$runner" | tr '[:upper:]' '[:lower:]')"; has "claude grok opencode" "$r" || { has "codex cursor qwen antigravity" "$r" && [[ -n "$price" ]]; } \
    || die "the scheduled runner needs a runner whose cost cabinet can count, or its limit could not hold: $runner does not report dollars$(has "codex cursor qwen antigravity" "$r" && echo "; set its price with --price")"; }
  [[ "$(printf %s "$ptime" | tr '[:upper:]' '[:lower:]')" == off ]] && ptime=off || ptime="$(when_norm "$ptime")" \
    || die "the pipeline time must be a time like \"10 PM\", days and a time like \"fri 9 PM\", or off"
  [[ "$(printf %s "$runner" | tr '[:upper:]' '[:lower:]')" == custom ]] || runner_cmd=""
  check_answers
  local credit_after="$o_credit"; ((set_credit)) && credit_after="$credit"
  check_credit "$credit_after"
  ((set_credit || !credit_bad)) || echo "Note: CABINET_CREDIT_ROLES is \"$o_credit\", which is not off or on, so no commit is credited. It stays until you set it: cabinet config --credit-roles off|on"
  if ((!cemail_given)) && [[ -n "$o_cemail" ]] && ! credit_email_ok "$o_cemail"; then
    echo "Note: CABINET_CREDIT_EMAIL is \"$o_cemail\", which is not a GitHub App's bot noreply email, so no commit is credited. It stays until you set it: cabinet config --credit-email <email>|off"
  fi
  [[ "$slug" == "$(slugify "$slug")" && -n "$slug" ]] || die "the slug must be lowercase letters, digits and dashes, like $(slugify "$slug")"
  backup_time="$(when_time_only "$backup_time")" || die "the backup time must be a time like \"1 PM\" or \"1:30 PM\", with no day: backups run every day"
  if [[ "$slug" != "$o_slug" ]]; then
    local other; other="$(slug_owner "$slug" "$ws")"
    [[ -z "$other" ]] || die "$(slug_taken "$slug" "$other"): choose another"
  fi
  # The backup folder stays outside every folder the workspace holds data in.
  local dd=("$ws") rp rn2 ru rf rl
  [[ "$(envget CABINET_LAYOUT)" == inside ]] && dd+=("$(cd "$ws/.." && pwd)")
  while IFS=$'\t' read -r rn2 ru rf rl rp; do
    rp="${rp:-$rn2}"; case "$rp" in /*) dd+=("$rp") ;; "~/"*) dd+=("$HOME/${rp#"~/"}") ;; *) dd+=("$ws/$rp") ;; esac
  done < <(awk -F'\t' -v OFS='\t' '{ sub(/\r$/, "") } !/^#/ && NF >= 2' "$ws/repos.tsv" 2>/dev/null)
  check_backup_outside "${dd[@]}"

  # This machine only: the backup lines of cabinet.local.env, which git never tracks.
  if ((this_machine)); then
    local cur_b="$o_backup" cur_t="$o_btime" new_b new_t lchanges=()
    lhas CABINET_BACKUP_DIR && cur_b="$(lget CABINET_BACKUP_DIR)"
    lhas CABINET_BACKUP_TIME && { cur_t="$(lget CABINET_BACKUP_TIME)"; cur_t="$(when_time_only "$cur_t" || printf '%s' "$cur_t")"; }
    if ((clear)); then
      lhas CABINET_BACKUP_DIR || lhas CABINET_BACKUP_TIME || { echo "Nothing to change: this machine already follows cabinet.env."; return 0; }
      new_b="$o_backup"; new_t="$o_btime"; lchanges+=("this machine: follow cabinet.env again (backups ${o_backup:-off}, at $o_btime)")
    else
      new_b="$cur_b"; new_t="$cur_t"
      ((set_backup)) && new_b="$backup"; ((set_btime)) && new_t="$backup_time"
      ((set_backup)) && { [[ "$new_b" != "$cur_b" ]] || ! lhas CABINET_BACKUP_DIR; } && lchanges+=("this machine: backups ${cur_b:-off} -> ${new_b:-off}")
      ((set_btime)) && { [[ "$new_t" != "$cur_t" ]] || ! lhas CABINET_BACKUP_TIME; } && lchanges+=("this machine: backup time $cur_t -> $new_t")
      ((set_credit)) && { [[ "$credit" != "$o_credit" ]] || ! lhas CABINET_CREDIT_ROLES; } \
        && lchanges+=("this machine: credit roles $( ((o_credit_set)) && printf %s "$o_credit" || echo "not answered") -> $credit")
    fi
    if ((${#lchanges[@]} == 0)); then echo "Nothing to change."; return 0; fi
    echo; echo "Changes (cabinet.local.env, this machine only; not committed):"; printf '  - %s\n' "${lchanges[@]}"
    if ((set_credit && shared)) && [[ "$credit" == on && "$o_cfile" != on ]]; then
      echo "Note: the project's credit roles setting is ${o_cfile:-not set}, and off for everyone wins: this machine's on counts only once it is on (cabinet config --credit-roles on)."
    fi
    ((dry)) && { echo "(dry run: nothing written)"; return 0; }
    local keep=(-e '^CABINET_BACKUP_DIR=' -e '^CABINET_BACKUP_TIME='); ((set_credit)) && keep+=(-e '^CABINET_CREDIT_ROLES=')
    {
      grep -v "${keep[@]}" "$lenv" 2>/dev/null || true
      ((set_credit)) && printf 'CABINET_CREDIT_ROLES="%s"\n' "$credit"
      if ((clear == 0)); then
        if ((set_backup)) || lhas CABINET_BACKUP_DIR; then printf 'CABINET_BACKUP_DIR="%s"\n' "$new_b"; fi
        if ((set_btime)) || lhas CABINET_BACKUP_TIME; then printf 'CABINET_BACKUP_TIME="%s"\n' "$new_t"; fi
      fi
    } > "$lenv.new"
    if [[ -s "$lenv.new" ]]; then mv "$lenv.new" "$lenv"; else rm -f "$lenv.new" "$lenv"; fi
    (( set_backup || set_btime || clear )) || return 0
    if ((apply)); then "$ws/bin/bootstrap.sh" || echo "bin/bootstrap.sh reported a problem: see above."
    else echo "Next: cabinet bootstrap (this machine's backup schedule follows the new setting)."; fi
    return 0
  fi

  # What changes, shown before anything is written.
  local changes=() rn
  [[ "$name" != "$o_name" ]] && changes+=("project name: $o_name -> $name")
  [[ "$slug" != "$o_slug" ]] && changes+=("slug: $o_slug -> $slug (schedules and the backup key move to the new name; old logs stay in the old folder)")
  [[ "$owner" != "$o_owner" || "$email" != "$o_email" ]] && changes+=("owner: $o_owner <$o_email> -> $owner <$email>")
  [[ "$roles" != "$o_roles" ]] && changes+=("roles: $o_roles -> $roles")
  [[ "$runner" != "$o_runner" || "$runner_cmd" != "$o_cmd" ]] && changes+=("runner: $o_runner${o_cmd:+ ($o_cmd)} -> $runner${runner_cmd:+ ($runner_cmd)}")
  [[ "$brief" != "$o_brief" ]] && changes+=("brief: ${o_brief:-off} -> ${brief:-off}")
  [[ "$week" != "$o_week" ]] && changes+=("week starts: ${o_week:-unset} -> $week")
  [[ "$writing" != "${o_writing:-standard}" ]] && changes+=("writing to the owner: ${o_writing:-standard} -> $writing")
  # Credit roles: cabinet.env, and this machine's answer too when it keeps one (always, in a shared workspace).
  local credit_w=0 l_credit="" l_credit_set=0 new_cemail="$o_cemail" agents_credit=0
  if lhas CABINET_CREDIT_ROLES; then l_credit="$(lget CABINET_CREDIT_ROLES)"; l_credit_set=1; fi
  if ((set_credit)) && { ((!o_cfile_set)) || [[ "$credit" != "$o_cfile" ]] || { ((l_credit_set || shared)) && [[ "$credit" != "$l_credit" ]]; }; }; then
    credit_w=1; changes+=("credit roles: $( ((o_credit_set)) && printf %s "$o_credit" || echo "not set") -> $credit")
  fi
  ((cemail_given)) && { [[ "$cemail" == off ]] && new_cemail="" || new_cemail="$cemail"; }
  ((set_credit)) && [[ "$credit" == off ]] && new_cemail=""   # off uses no email, so none is kept
  [[ "$new_cemail" != "$o_cemail" ]] && changes+=("credit email: ${o_cemail:-the Cabinet Team app} -> ${new_cemail:-the Cabinet Team app}")
  [[ "$hard" != "$o_hard" ]] && changes+=("hard to undo: ${o_hard:-not set} -> ${hard:-not set}")
  [[ "$pipe" != "$o_pipe" ]] && changes+=("scheduled runner: $o_pipe -> $pipe")
  [[ "$plimit" != "$o_plimit" ]] && changes+=("its cost limit per run: $( [[ -n "$o_plimit" ]] && echo "\$$o_plimit" || echo none) -> $( [[ -n "$plimit" ]] && echo "\$$plimit" || echo none)")
  [[ "$pipe" != off && "$ptime" != "${o_ptime:-}" ]] && changes+=("it runs: ${o_ptime:-not scheduled} -> $ptime")
  [[ "$backup" != "$o_backup" ]] && changes+=("backups: ${o_backup:-off} -> ${backup:-off}$(if lhas CABINET_BACKUP_DIR; then echo " (this machine keeps its own folder from cabinet.local.env; cabinet config --this-machine --clear follows this one)"; fi)")
  [[ -n "$backup" && "$backup_time" != "$o_btime" ]] && changes+=("backup time: $o_btime -> $backup_time")
  [[ "$price" != "$o_price" ]] && changes+=("price per million tokens (input, output, cached input): ${o_price:-off} -> ${price:-off}")
  [[ "$budget" != "$o_budget" ]] && changes+=("budget: $( [[ -n "$o_budget" ]] && echo "\$$o_budget a week" || echo off) -> $( [[ -n "$budget" ]] && echo "\$$budget a week" || echo off)")
  local newrows=()
  for r in ${repos[@]+"${repos[@]}"}; do
    url_ok "$r" || die "'$r' is not a git URL (https://, ssh://, git@host:path or a local path)"
    rn="$(basename "$r" .git)"; name_ok "$rn" || die "'$r' gives the repo name '$rn', which is not a plain folder name"
    { cut -f1 "$ws/repos.tsv" 2>/dev/null; printf '%s\n' ${newrows[@]+"${newrows[@]}"} | cut -f1; } | grep -qxF "$rn" && { echo "  a repo named $rn is already listed, skipped $r"; continue; }
    newrows+=("$rn"$'\t'"$r"$'\t-\tyes'); changes+=("add repo: $rn ($r)")
  done
  if ((${#changes[@]} == 0)); then echo "Nothing to change."; return 0; fi
  echo; echo "Changes:"; printf '  - %s\n' "${changes[@]}"
  ((dry)) && { echo "(dry run: nothing written)"; return 0; }
  if ((tty)); then confirm "Apply them?" y || die "nothing changed"; fi
  # Committed at the end when the workspace has its own git and held no uncommitted change before, so
  # only this change goes in. A command that calls config for its own change sets CABINET_NO_COMMIT.
  local cfg_clean=0
  [[ -z "${CABINET_NO_COMMIT:-}" && "$(cd "$(git -C "$ws" rev-parse --show-toplevel 2>/dev/null || echo /nonexistent)" 2>/dev/null && pwd -P)" == "$(cd "$ws" && pwd -P)" &&
     -z "$(git -C "$ws" status --porcelain 2>/dev/null)" ]] && cfg_clean=1

  # Write them.
  setenv() {  # setenv <key> <value> [single]: set a cabinet.env line, or add it
    local q='"'; [[ "${3:-}" == single ]] && q="'"
    if grep -q "^$1=" "$ws/cabinet.env"; then K="$1" V="$2" Q="$q" node "$LIBJS" sub "$ws/cabinet.env" -- '/^${K}=.*/' '${K}=${Q}${V}${Q}'
    else printf '%s=%s%s%s\n' "$1" "$q" "$2" "$q" >> "$ws/cabinet.env"; fi
  }
  setenv CABINET_PROJECT "$name"; setenv CABINET_ROLES "$roles"; setenv CABINET_RUNNER "$runner"
  setenv CABINET_RUNNER_CMD "$runner_cmd" single; setenv CABINET_BACKUP_DIR "$backup"; setenv CABINET_BACKUP_TIME "$backup_time"
  [[ "$budget" == "$o_budget" ]] || setenv CABINET_BUDGET "$budget"
  [[ "$price" == "$o_price" ]] || setenv CABINET_PRICE "$price"
  if ((credit_w)); then
    setenv CABINET_CREDIT_ROLES "$credit"
    if ((l_credit_set || shared)); then
      { grep -v '^CABINET_CREDIT_ROLES=' "$lenv" 2>/dev/null || true; printf 'CABINET_CREDIT_ROLES="%s"\n' "$credit"; } > "$lenv.new" && mv "$lenv.new" "$lenv"
    fi
    # The "Commits." house rule follows it: one sentence changes, the owner's other words stay.
    local asum; asum="$(cksum < "$ws/AGENTS.md" 2>/dev/null || true)"
    node "$LIBJS" credit-line "$ws/AGENTS.md" "$([[ "$credit" == on ]] && echo on || echo off)" \
      || echo "AGENTS.md: the \"Commits.\" house rule holds neither of the kit's attribution sentences, so it was left as it is. It needs your own edit to say whether the Cabinet role credit line is allowed."
    [[ "$(cksum < "$ws/AGENTS.md" 2>/dev/null || true)" == "$asum" ]] || agents_credit=1
  fi
  [[ "$new_cemail" == "$o_cemail" ]] || setenv CABINET_CREDIT_EMAIL "$new_cemail"
  # The files under jobs/ and package.json this run writes, so only those are committed.
  local wjobs=() wpkg=0
  if [[ -f "$ws/jobs/brief.job" && "$brief" != "$o_brief" ]]; then W="$brief" node "$LIBJS" sub "$ws/jobs/brief.job" -- '/^WHEN=.*/' 'WHEN="${W}"'; wjobs+=(jobs/brief.job); fi
  local Week; Week="$(printf %s "${week:0:1}" | tr '[:lower:]' '[:upper:]')${week:1}"
  # An AGENTS.md from before the setting gets its line after the week start.
  if [[ "$writing" != "${o_writing:-standard}" ]]; then
    if [[ -n "$o_writing" ]]; then G="$writing" node "$LIBJS" sub "$ws/AGENTS.md" -- '/^(- \*\*Writing to the owner:\*\*) \w+\./' '$1 ${G}.'
    else node "$LIBJS" after "$ws/AGENTS.md" '/^- \*\*Week starts on:\*\*/' "- **Writing to the owner:** $writing. \`short\` gives the shortest briefs, questions and answers (\`cabinet config --writing short\`; \`CABINET.md\`, \"Writing to the owner\")."; fi
  fi
  [[ "$pipe" == "$o_pipe" ]] || setenv CABINET_PIPELINE "$pipe"
  [[ "$plimit" == "$o_plimit" ]] || setenv CABINET_PIPELINE_LIMIT "$plimit"
  # The pipeline job, made when the runner is first turned on; off leaves it in place, doing nothing.
  if [[ "$pipe" != off && ! -f "$ws/jobs/pipeline.job" ]]; then
    cat > "$ws/jobs/pipeline.job" <<'JOB'
# The scheduled runner (cabinet config --pipeline small|all). Run now: cabinet job run pipeline
# It moves the work CABINET_PIPELINE allows, within CABINET_PIPELINE_LIMIT dollars a run, and writes
# what happened to PIPELINE.md. WHEN as in brief.job; after changing it: cabinet bootstrap.
COMMAND="bin/handoff.sh run --scheduled"
WHEN=""
MINUTES="many"
RESULT="PIPELINE.md"
TIMEOUT="0"
JOB
    wjobs+=(jobs/pipeline.job)
  fi
  if [[ "$pipe" != off && -f "$ws/jobs/pipeline.job" && "$ptime" != "${o_ptime:-}" ]]; then
    W="$([[ "$ptime" == off ]] || printf %s "$ptime")" node "$LIBJS" sub "$ws/jobs/pipeline.job" -- '/^WHEN=.*/' 'WHEN="${W}"'; wjobs+=(jobs/pipeline.job)
  fi
  if [[ -n "$hard" && "$hard" != "$o_hard" ]]; then hard_write "$ws" "$hard" || die "AGENTS.md: could not write the Hard to undo section"; fi
  [[ "$week" == "$o_week" && "$owner" == "$o_owner" && "$email" == "$o_email" ]] || D="$Week" O="$owner" E="$email" node "$LIBJS" sub "$ws/AGENTS.md" -- \
    '/^(- \*\*Week starts on:\*\*) \w+\./' '$1 ${D}.' \
    '/^(- \*\*Commits\.\*\* Authored as ).*? <[^>]*>\./' '$1${O} <${E}>.'
  local files=() f
  for f in AGENTS.md HANDOFFS.md OPERATIONS.md README.md specs/ROADMAP.md cabinet.env; do [[ -f "$ws/$f" ]] && files+=("$ws/$f"); done
  # The workspace's own package.json names the workspace (not a project's, which is never touched).
  if [[ "$name" != "$o_name" || "$slug" != "$o_slug" ]] && [[ -f "$ws/package.json" ]] && json -e '$.private === true && String($.name).endsWith("-workspace")' "$ws/package.json" >/dev/null 2>&1; then
    local pj2; pj2="$(json --arg n "$slug-workspace" --arg d "$name workspace, run with the cabinet kit." '({...$, name: $n, description: $d})' "$ws/package.json")" \
      && [[ -n "$pj2" ]] && printf '%s\n' "$pj2" > "$ws/package.json" && wpkg=1
  fi
  if [[ "$name" != "$o_name" ]]; then
    # The titles setup wrote; other mentions are the project's own text.
    O="$o_name" N="$name" node "$LIBJS" sub "${files[@]}" -- \
      '/^(# AGENTS\.md - )${O}$/' '$1${N}' '/^(## What )${O}( is)$/' '$1${N}$2' '/(specific to )${O}( and wins)/' '$1${N}$2' \
      '/^(# HANDOFFS\.md - )${O}$/' '$1${N}' '/^# ${O}( operations manual)$/' '# ${N}$1' '/(how to run )${O}( day to day)/' '$1${N}$2' \
      '/^# ${O}( workspace)$/' '# ${N}$1' '/^(# Roadmap - )${O}$/' '$1${N}' '/^# ${O}( settings for)/' '# ${N}$1' \
      '/(tie the )${O}( repos together)/' '$1${N}$2' '/(What is specific to )${O}( \|)/' '$1${N}$2'
  fi
  if [[ "$slug" != "$o_slug" ]]; then
    # Stop this workspace's schedules under the old name; bootstrap installs them under the new one.
    local live
    for live in "$SCHED_DIR/ai.cabinet.$o_slug".*"$SCHED_EXT"; do
      [[ -f "$live" && "$(sched_ws "$live")" == "$ws" ]] || continue
      sched_unload "$(sched_label "$live")"; echo "  stopped $(sched_label "$live")"
    done
    setenv CABINET_SLUG "$slug"
    claim_slug "$slug" "$ws"
    # Release the old slug when this workspace held it, so another workspace can use it.
    local oc="$LOGROOT/$o_slug/workspace"
    [[ -f "$oc" && "$(abspath "$(cat "$oc")")" == "$ws" ]] && rm -f "$oc"
    local sfiles=()
    for f in "$ws/OPERATIONS.md" "$ws/README.md" "$ws"/jobs/*.job; do [[ -f "$f" ]] && sfiles+=("$f"); done
    # Only the jobs the rewrite changes are listed, so another session's edit to one it leaves alone stays theirs.
    local jsum; jsum="$(cksum "$ws"/jobs/*.job 2>/dev/null || true)"
    ((${#sfiles[@]})) && O="$o_slug" N="$slug" node "$LIBJS" sub "${sfiles[@]}" -- \
      '/ai\.cabinet\.${O}\b/g' 'ai.cabinet.${N}' '/(Logs|state)\/cabinet\/${O}\//g' '$1/cabinet/${N}/' \
      '/cabinet\.${O}\.backup/g' 'cabinet.${N}.backup' '/^(git clone <this repo> )${O}( && cd )${O}$/' '$1${N}$2${N}'
    for f in "$ws"/jobs/*.job; do [[ -f "$f" ]] && ! grep -qxF "$(cksum "$f")" <<<"$jsum" && wjobs+=("jobs/${f##*/}"); done
  fi
  # Team tables follow the roles: a dropped role's row leaves, a returning one comes back from the kit's template.
  local f row
  for f in AGENTS.md OPERATIONS.md; do
    [[ -f "$ws/$f" && "$roles" != "$o_roles" ]] || continue
    for r in $ROLES_ALL $ROLES_OPT; do
      if has "$roles" "$r"; then
        grep -qF "| $r |" "$ws/$f" && continue
        row="$(grep -F "| $r |" "$KIT/templates/workspace/$f" | head -1)"; [[ -n "$row" ]] || continue
        node "$LIBJS" after-last "$ws/$f" "$row" $ROLES_ALL $ROLES_OPT
      else
        node "$LIBJS" drop-text "$ws/$f" "| $r |"
      fi
    done
    # A role the project defines itself gets a row to fill in, so the manual names it.
    for r in $roles; do
      has "$ROLES_ALL $ROLES_OPT" "$r" && continue
      grep -qF "| $r |" "$ws/$f" && continue
      if [[ "$f" == OPERATIONS.md ]]; then row="| $r | TBD: what it does |"; else row="| TBD | TBD | $r |"; fi
      node "$LIBJS" after-last "$ws/$f" "$row" $ROLES_ALL $ROLES_OPT $extra_roles
    done
  done
  for row in ${newrows[@]+"${newrows[@]}"}; do
    printf '%s\n' "$row" >> "$ws/repos.tsv"
    rn="${row%%$'\t'*}"
    grep -qF "| \`$rn\` |" "$ws/AGENTS.md" || node "$LIBJS" before "$ws/AGENTS.md" '/^\| workspace \(this folder\)/' "| \`$rn\` | TBD | TBD |"
  done
  # The role files as they were, so only those the build (or bootstrap) changes are committed.
  local rsum; rsum="$(cksum "$ws/ORG.md" "$ws"/agents/*.md "$ws"/.claude/agents/*.md 2>/dev/null || true)"
  # ORG.md's heading names the project, so a rename rebuilds the roles too.
  [[ "$roles" != "$o_roles" || "$name" != "$o_name" ]] && "$ws/bin/role.sh" build

  # Schedules, a new slug and new repos take effect through bootstrap.
  local needs=0 boot=0 noclaude=0
  # bootstrap links CLAUDE.md when it is missing: only then is the link this run's to commit.
  [[ -e "$ws/CLAUDE.md" || -L "$ws/CLAUDE.md" ]] || noclaude=1
  [[ "$brief" != "$o_brief" || "$backup" != "$o_backup" || "$backup_time" != "$o_btime" || "$slug" != "$o_slug" ]] && needs=1
  [[ "$pipe" != "$o_pipe" || ( "$pipe" != off && "$ptime" != "${o_ptime:-}" ) ]] && needs=1
  ((${#newrows[@]})) && needs=1
  if ((needs)); then
    if ((apply)); then boot=1; "$ws/bin/bootstrap.sh" || echo "bin/bootstrap.sh reported a problem: see above."
    elif ((tty)) && confirm "Update schedules and clone new repos now (bin/bootstrap.sh)? It shows the changes first." y; then
      "$ws/bin/bootstrap.sh" --dry-run
      if confirm "Apply these changes?" y; then boot=1; "$ws/bin/bootstrap.sh" || echo "bin/bootstrap.sh reported a problem: see above."; fi
    else echo "Next: cabinet bootstrap (schedules and repos follow the new settings)."; fi
  fi
  if [[ "$slug" != "$o_slug" && -n "$backup" ]]; then
    echo "The backup passphrase is now read from cabinet.$slug.backup in the $PASS_STORE. Add it once, with the same passphrase:"
    echo "  $(pass_add_cmd "cabinet.$slug.backup")"
    echo "then remove the old one, cabinet.$o_slug.backup."
  fi
  local keys="" c
  for c in "${changes[@]}"; do keys+="${keys:+, }${c%%:*}"; done
  # Only the files this run wrote, each for the settings that change it, so a change someone else
  # makes meanwhile to any other file stays theirs to commit.
  local p
  local cfg_files=() wrote=(cabinet.env)
  if [[ "$name" != "$o_name" || "$owner" != "$o_owner" || "$email" != "$o_email" || "$week" != "$o_week" || "$writing" != "${o_writing:-standard}" || "$hard" != "$o_hard" || "$roles" != "$o_roles" ]] || ((${#newrows[@]} || agents_credit)); then
    wrote+=(AGENTS.md)
  fi
  [[ "$name" != "$o_name" || "$slug" != "$o_slug" || "$roles" != "$o_roles" ]] && wrote+=(OPERATIONS.md)
  ((wpkg)) && wrote+=(package.json)
  wrote+=(${wjobs[@]+"${wjobs[@]}"})
  [[ "$name" != "$o_name" ]] && wrote+=(HANDOFFS.md README.md specs/ROADMAP.md)
  [[ "$slug" != "$o_slug" ]] && wrote+=(README.md)
  ((${#newrows[@]})) && wrote+=(repos.tsv)
  # The roles are built by a role change or a rename (ORG.md's heading), and by bootstrap when it ran:
  # only the role files that changed, appeared or went since before the build, as for jobs.
  if [[ "$roles" != "$o_roles" || "$name" != "$o_name" ]] || ((boot)); then
    for p in "$ws/ORG.md" "$ws"/agents/*.md "$ws"/.claude/agents/*.md; do
      [[ -f "$p" ]] && ! grep -qxF "$(cksum "$p")" <<<"$rsum" && wrote+=("${p#"$ws/"}")
    done
    while read -r _ _ p; do [[ -n "$p" && ! -e "$p" ]] && wrote+=("${p#"$ws/"}"); done <<<"$rsum"
  fi
  ((boot && noclaude)) && wrote+=(CLAUDE.md)
  if ((cfg_clean)); then
    while IFS= read -r p; do cfg_files+=("$p"); done < <(git -C "$ws" status --porcelain -uall -- "${wrote[@]}" 2>/dev/null | cut -c4-)
  fi
  if ((${#cfg_files[@]})) && git -C "$ws" add -A -- "${cfg_files[@]}" 2>/dev/null &&
     git -C "$ws" -c commit.gpgsign=false commit -q -m "cabinet config: $keys" -- "${cfg_files[@]}" >/dev/null 2>&1; then
    echo "Committed in the workspace: cabinet config: $keys"
  else
    echo "Review with git -C \"$ws\" diff, then commit."
  fi
}

# The workspace a command means: <dir> itself, or <dir>/cabinet inside a project. With no
# <dir>, the nearest one from here upward, so commands work from any folder inside a
# workspace or its project.
find_ws_up() {
  local d; d="$(pwd -P)"
  while :; do
    [[ -f "$d/.cabinet/version" ]] && { echo "$d"; return 0; }
    [[ -f "$d/cabinet/.cabinet/version" ]] && { echo "$d/cabinet"; return 0; }
    [[ "$d" == / ]] && return 1
    d="$(dirname "$d")"
  done
}
find_ws() {
  local d="${1:-}"
  if [[ -z "$d" ]]; then find_ws_up || pwd -P; return 0; fi
  [[ -f "$d/.cabinet/version" ]] || { [[ -f "$d/cabinet/.cabinet/version" ]] && d="$d/cabinet"; }
  cd "$d" && pwd -P
}
need_ws() {
  local ws; ws="$(find_ws_up)" || die "not inside a cabinet workspace, or a project with cabinet/ in it. cd into one, or start one: cabinet new, or cabinet init in an existing project"
  echo "$ws"
}
# A noun's verb through its workspace script, bin/<noun>.sh <verb>; a noun alone shows its verbs.
noun_script() {
  local noun=$1; shift
  [[ -n "${1:-}" ]] || { cmd_help "$noun"; exit 0; }
  is_cmd "$noun $1" || { echo "$ERR_TAG unknown command '$noun $1'" >&2; cmd_help "$noun" >&2; exit 2; }
  ws_script "$noun.sh" "$@"
}
# cabinet repo add through config (the same checks as setup); the rest through bin/repo.sh.
cmd_repo() {
  if [[ "${1:-}" == add ]]; then
    shift
    local url="" x apply=() dry=()
    for x in "$@"; do case "$x" in --apply) apply=(--apply) ;; --dry-run) dry=(--dry-run) ;; -*) bad_usage "unknown option $x (see: cabinet repo add --help)" ;; *) [[ -z "$url" ]] || bad_usage "one repo at a time"; url="$x" ;; esac; done
    [[ -n "$url" ]] || bad_usage "usage: cabinet repo add <git url> [--apply] [--dry-run]"
    local ws; ws="$(need_ws)" || exit 1
    exec "$KIT/bin/cabinet" -C "$ws" config --yes --repo "$url" ${apply[@]+"${apply[@]}"} ${dry[@]+"${dry[@]}"}
  fi
  noun_script repo "$@"
}
# Restore works before any workspace exists (a new machine): the kit's own copy then.
cmd_backup() {
  if [[ "${1:-}" == restore ]]; then
    local ws; if ws="$(find_ws_up)"; then exec "$ws/bin/backup.sh" "$@"; else exec "$KIT/scripts/backup.sh" "$@"; fi
  fi
  noun_script backup "$@"
}
# Run a workspace script by name from anywhere inside the workspace or its project.
ws_script() { local script=$1 ws; shift; ws="$(need_ws)" || exit 1; exec "$ws/bin/$script" "$@"; }

# What to do next in this workspace, in the order it matters. Fast and read-only:
# it reads the workspace's files and asks the doctor for its count.
cmd_next() {
  local json=0 x
  for x in "$@"; do case "$x" in --json) json=1 ;; *) bad_usage "unknown option $x (see: cabinet next --help)" ;; esac; done
  local ws; ws="$(find_ws_up)" || {
    if ((json)); then json -n '({workspace: null, steps: [{id: "start", text: "Start a workspace: cabinet new (a new folder), or cabinet init (an existing project or folder of repos).", command: "cabinet new"}], optional: []})'
    else
      echo "${S_B}Not inside a cabinet workspace.${S_Z}"
      echo "  ${S_Y}1.${S_Z} Start one: cabinet new (a new folder), or cabinet init (an existing project or folder of repos)."
      ls "$LOGROOT"/*/workspace >/dev/null 2>&1 && echo "  Or cd into one of yours: cabinet list shows them."
    fi
    return 0
  }
  # Each step: an ID that never changes, the text, and the command that does it (or "").
  local steps="" env="$ws/cabinet.env" heads miss
  step() { steps+="$1"$'\t'"$2"$'\t'"${3:-}"$'\n'; }
  # The tools cabinet needs come before anything else.
  miss="$(deps_missing)"
  [[ -z "$miss" ]] || step deps "Install the tools cabinet needs: ${miss// /, } (sudo asks for your password on Linux)." "$(deps_cmd "$miss" || echo "")"
  envget() { ( set +u; source "$env" >/dev/null 2>&1; printf '%s' "${!1:-}" ); }
  # What the project says about itself: a TBD left to fill, not one quoted as code in the template's own
  # instructions (`TBD`).
  heads="$(awk '/^## / {h = substr($0, 4)} {l = $0; gsub(/`[^`]*`/, "", l)} l ~ /TBD/ && h != "" && !(h in seen) {seen[h] = 1; printf "%s%s", (n++ ? ", " : ""), h}' "$ws/AGENTS.md" 2>/dev/null)"
  [[ -n "$heads" ]] && step tbd "Fill the TBDs in AGENTS.md: $heads." ""
  # The workspace's own history.
  if [[ -e "$ws/.git" ]] && ! git -C "$ws" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    step commit "Set the owner, then commit the workspace." 'cabinet config --owner "Your Name" --email you@example.com'
  fi
  # The pinned kit.
  local pin="$ws"; [[ -f "$ws/package.json" ]] || pin="$(dirname "$ws")"
  if grep -q '@tarekraafat/cabinet' "$pin/package.json" 2>/dev/null && [[ ! -d "$pin/node_modules/@tarekraafat/cabinet" ]]; then
    step install "Download the pinned kit (in $pin)." "npm install"
  fi
  # This machine: guardrails and schedules.
  local slug label jf when missing=0
  slug="$(envget CABINET_SLUG)"; label="ai.cabinet.$slug"
  [[ -x "$(git config --global core.hooksPath 2>/dev/null)/pre-push" ]] || missing=1
  # A machine set to schedule no jobs (cabinet.local.env) is not missing them.
  grep -qx 'CABINET_SCHEDULES="\{0,1\}off"\{0,1\}' "$ws/cabinet.local.env" 2>/dev/null || for jf in "$ws"/jobs/*.job; do
    [[ -f "$jf" ]] || continue
    when="$(WHEN=""; source "$jf" >/dev/null 2>&1; printf '%s' "$WHEN")"
    [[ -n "$when" && "$SCHEDULER" != none && ! -f "$(sched_file "$label.$(basename "$jf" .job)")" ]] && missing=1
  done
  ((missing)) && step bootstrap "Set up this machine: guardrails and schedules (add --dry-run to see the changes first)." "cabinet bootstrap"
  # Credit roles, asked once until answered: in cabinet.env, or this machine's cabinet.local.env (in a shared
  # workspace, only while the project's setting is on: off for everyone wins). Nothing is credited until then.
  local pcredit; pcredit="$(envget CABINET_CREDIT_ROLES)"
  if [[ "$(envget CABINET_LAYOUT)" == inside && "$(envget CABINET_VISIBILITY)" == shared && "$pcredit" != on ]]; then
    grep -q '^CABINET_CREDIT_ROLES=' "$env" 2>/dev/null \
      || step credit-roles "Credit roles: say whether commits made in Cabinet runs credit their role beside you, with one Co-authored-by line that shows the Cabinet Team avatar on GitHub (on), or not (off). Nothing is credited until you answer." "cabinet config --credit-roles on"
  elif ! grep -q '^CABINET_CREDIT_ROLES=' "$ws/cabinet.local.env" 2>/dev/null; then
    if [[ "$(envget CABINET_LAYOUT)" == inside && "$(envget CABINET_VISIBILITY)" == shared ]]; then
      step credit-roles "Credit roles: say whether commits made in this machine's Cabinet runs credit their role beside you, with one Co-authored-by line that shows the Cabinet Team avatar on GitHub (on), or not (off). Nothing is credited until you answer." "cabinet config --this-machine --credit-roles on"
    elif ! grep -q '^CABINET_CREDIT_ROLES=' "$env" 2>/dev/null; then
      step credit-roles "Credit roles: say whether commits made in Cabinet runs credit their role beside you, with one Co-authored-by line that shows the Cabinet Team avatar on GitHub (on), or not (off). Nothing is credited until you answer." "cabinet config --credit-roles on"
    fi
  fi
  # Work waiting on the owner.
  local waiting
  waiting="$("$ws/bin/handoff.sh" list owner 2>/dev/null | grep -c '^### H-' || true)"
  ((waiting)) && step handoffs "$waiting handoff(s) wait on you." "cabinet handoff list owner"
  if [[ -f "$ws/BRIEF.md" ]]; then step brief "Read today's brief, BRIEF.md (written $(human_mtime "$ws/BRIEF.md")), and answer its sign-off queue." ""
  else
    when="$( [[ -f "$ws/jobs/brief.job" ]] && (WHEN=""; source "$ws/jobs/brief.job" >/dev/null 2>&1; printf '%s' "$WHEN") )"
    if [[ -n "$when" ]]; then step brief "The first brief comes at $when (or write it now)." "cabinet brief"; else step brief "Write a brief now." "cabinet brief"; fi
  fi
  # Everything else the doctor knows.
  local problems
  # The doctor exits 1 when it finds problems: read its count, not its exit code.
  problems="$( { "$ws/bin/doctor.sh" --json 2>/dev/null || true; } | json -r '$.problems ?? 0' 2>/dev/null || true)"
  [[ "$problems" =~ ^[1-9] ]] && step doctor "The doctor found $problems thing(s) to fix (cabinet doctor --fix runs the ones it can)." "cabinet doctor"
  local optional=""
  local bdir; bdir="$(envget CABINET_BACKUP_DIR)"
  grep -q '^CABINET_BACKUP_DIR=' "$ws/cabinet.local.env" 2>/dev/null && bdir="$(sed -n 's/^CABINET_BACKUP_DIR="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$ws/cabinet.local.env" | tail -1)"
  [[ -z "$bdir" ]] && optional="backups"$'\t'"Daily encrypted backups."$'\t'"cabinet config --backup-dir <a folder outside the workspace>"$'\n'

  if ((json)); then
    json -n --arg ws "$ws" --arg project "$(envget CABINET_PROJECT)" --arg steps "$steps" --arg optional "$optional" '((rows) =>
      ({workspace: $ws, project: $project, steps: rows($steps), optional: rows($optional)}))
      ((s) => s.split("\n").filter(Boolean).map((l) => l.split("\t")).map((r) => ({id: r[0], text: r[1], command: r[2]})))'
    return 0
  fi
  # Styled (platform.sh): the first line bold with its folder dim, step numbers yellow (they wait on
  # the owner), the command to run bold.
  echo "${S_B}Next in $(envget CABINET_PROJECT)${S_Z} ${S_D}($ws)${S_Z}${S_B}:${S_Z}"
  local n=0 id text cmd
  while IFS=$'\t' read -r id text cmd; do
    [[ -n "$id" ]] || continue
    n=$((n + 1)); echo "  ${S_Y}$n.${S_Z} $text${cmd:+ Run: ${S_B}$cmd${S_Z}}"
  done <<<"$steps"
  while IFS=$'\t' read -r id text cmd; do [[ -n "$id" ]] && echo "  Optional: $text Run: ${S_B}$cmd${S_Z}"; done <<<"$optional"
  ((n)) || echo "  ${S_G}Nothing waits on you.${S_Z} cabinet doctor checks everything; cabinet outdated looks for a newer kit."
  return 0
}

# Every workspace this machine knows: "<slug><TAB><folder>", from the slug claims in
# <logs>/<slug>/workspace that setup and bootstrap write (LOGROOT, bin/platform.sh).
known_workspaces() {
  local claim
  for claim in "$LOGROOT"/*/workspace; do
    [[ -f "$claim" ]] && printf '%s\t%s\n' "$(basename "$(dirname "$claim")")" "$(head -1 "$claim")"
  done
  return 0
}

# One morning read: the sign-off queue and the owner's actions from the latest brief of
# every workspace on this machine, by the headings chief-of-staff writes. Answers still go to
# each workspace's own agent. Reads only, except --write (its file) and --schedule.
DIGEST_LABEL="ai.cabinet-digest"   # outside ai.cabinet.<slug>.*: never a workspace's schedule
DIGEST_FILE_DEFAULT="$LOGROOT/digest.md"
DIGEST_WHEN_DEFAULT="10:00 AM"   # --schedule with no time: every day
cmd_digest() {
  local json=0 write="" notify=0 when="" file="" x
  while (($#)); do
    case "$1" in
      --json) json=1; shift ;;
      --write) need "--write needs a file" "$@"; write="$2"; shift 2 ;;
      --notify) notify=1; shift ;;
      --schedule) if [[ -n "${2:-}" && "$2" != --* ]]; then when="$2"; shift 2; else when="$DIGEST_WHEN_DEFAULT"; shift; fi ;;
      --file) need "--file needs a file" "$@"; file="$2"; shift 2 ;;
      *) bad_usage "unknown option $1 (see: cabinet digest --help)" ;;
    esac
  done
  if [[ -n "$when" ]]; then digest_schedule "$when" "${file:-$DIGEST_FILE_DEFAULT}" "$notify"; return; fi
  [[ -z "$file" ]] || die "--file goes with --schedule; to write the digest now: cabinet digest --write <file>"

  local slug ws project brief written iso stale queue actions waiting spent budget n=0 rows=""
  section_of() { awk -v h="## $2" '/^## / {on = ($0 == h); next} on' "$1" | sed -e '/./,$!d' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'; }
  while IFS=$'\t' read -r slug ws; do
    n=$((n + 1))
    [[ -f "$ws/.cabinet/version" ]] || { rows+="$slug"$'\037'""$'\037'"$ws"$'\037'"gone"$'\037\037\037\037\037\037\037\n'; continue; }
    project="$( ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${CABINET_PROJECT:-}" ) )"
    waiting="$("$ws/bin/handoff.sh" list owner 2>/dev/null | grep -c '^### H-' || true)"
    brief="$ws/BRIEF.md" written="" iso="" stale="" queue="" actions=""
    if [[ -f "$brief" ]]; then
      written="$(human_mtime "$brief")"; iso="$(date -u -r "$brief" +%Y-%m-%dT%H:%M:%SZ)"
      (( $(date +%s) - $(mtime "$brief") > 36 * 3600 )) && stale=1
      grep -qx '## Sign-off queue' "$brief" && queue="$(section_of "$brief" "Sign-off queue")" || queue=$'\001'   # \001: no such heading
      actions="$(section_of "$brief" "Actions for the owner")"
      # Links in the brief start at its workspace (evidence, verdict notes); the digest is read elsewhere.
      local rel='](specs/' to="]($ws/specs/"
      queue="${queue//"$rel"/$to}" actions="${actions//"$rel"/$to}"
    fi
    IFS='|' read -r spent budget <<<"$(ws_spend "$ws")" || true
    # One record per workspace; \002 stands for a line break inside a field.
    rows+="$slug"$'\037'"$project"$'\037'"$ws"$'\037'"ok"$'\037'"$written"$'\037'"$iso"$'\037'"$stale"$'\037'"${queue//$'\n'/$'\002'}"$'\037'"${actions//$'\n'/$'\002'}"$'\037'"$waiting"$'\037'"$spent"$'\037'"$budget"$'\n'
  done < <(known_workspaces)

  if ((json)); then
    printf '%s' "$rows" | json -R '$.map((l) => l.split("\u001f").map((f) => f.replaceAll("\u0002", "\n"))).map((r) => ({slug: r[0], project: r[1], path: r[2],
      exists: r[3] == "ok", brief_written: str(r[5]), brief_stale: r[6] == "1",
      sign_off_queue: r[7] == "\u0001" ? null : str(r[7]),
      queue_heading_found: r[5] == "" ? null : r[7] != "\u0001",
      actions_for_owner: str(r[8]), waiting_on_owner: num(r[9]), spend_this_week_usd: num(r[10]), budget_usd: num(r[11])}))'
    return 0
  fi

  # The counts a notification gives: numbered queue items, action lines, waiting handoffs, late briefs.
  local decisions=0 acts=0 handoffs=0 late=0 needy=0 tight=0 total=0.00 reported=0 exists q a c
  while IFS=$'\037' read -r slug project ws exists written iso stale queue actions waiting spent budget; do
    [[ -n "$slug" && "$exists" == ok ]] || continue
    q="$(printf '%s\n' "${queue//$'\002'/$'\n'}" | grep -cE '^[0-9]+\. ' || true)"
    a="$(printf '%s\n' "${actions//$'\002'/$'\n'}" | grep -cE '^[-*] ' || true)"
    c=$((q + a + ${waiting:-0})); decisions=$((decisions + q)); acts=$((acts + a)); handoffs=$((handoffs + ${waiting:-0}))
    [[ -z "$written" || -n "$stale" || "$queue" == $'\001' ]] && { late=$((late + 1)); c=$((c + 1)); }
    if [[ -n "$spent" ]]; then
      reported=1; total="$(awk -v a="$total" -v b="$spent" 'BEGIN { printf "%.2f", a + b }')"
      [[ -n "$budget" ]] && (( $(budget_pct "$spent" "$budget") >= 80 )) && { tight=$((tight + 1)); c=$((c + 1)); }
    fi
    ((c)) && needy=$((needy + 1))
  done <<<"$rows"
  local summary
  if ((decisions + acts + handoffs + late + tight == 0)); then summary="Nothing waits on you in $n project(s)."
  else
    summary="$decisions decision(s), $acts action(s) and $handoffs handoff(s) wait on you in $needy of $n project(s)."
    ((late)) && summary+=" $late brief(s) late, missing or unreadable."
    ((tight)) && summary+=" $tight project(s) at 80% of their budget or more."
  fi
  ((reported)) && summary+=" Agent runs cost \$$total this week in all."

  if [[ -n "$write" ]]; then
    styles off   # a file is never styled
    write="$(abspath "$write")"
    mkdir -p "$(dirname "$write")" || die "cannot make the folder for $write"
    { echo "# cabinet digest, $(LC_ALL=C date "+%-d %b %Y, %-I:%M %p")"; echo; echo "$summary"; echo; digest_text "$n" "$rows"; } > "$write.new" && mv "$write.new" "$write" \
      || die "cannot write $write"
    echo "Wrote the digest to $write"
  else
    ((n)) && { echo "${S_B}$summary${S_Z}"; echo; }
    digest_text "$n" "$rows"
    digest_schedule_line
  fi
  if ((notify)); then
    notify "$summary" "${write:+Open $write}" >/dev/null 2>&1 \
      || echo "$ERR_TAG the notification could not be shown ($( if [[ $OS == mac ]]; then echo "System Settings > Notifications"; elif [[ -n "$(deps_missing notify-send)" ]]; then deps_hint notify-send; else echo "notify-send failed"; fi))" >&2
  fi
  return 0
}

# ws_spend <workspace>: "<dollars this week>|<budget>", from the workspace's own scripts. Dollars are
# empty when its runner does not report cost, or its kit predates spend tracking.
ws_spend() {
  bash -c 'source "$1/bin/lib.sh" && declare -F spend_counts >/dev/null || exit 0
    spend_counts && printf %s "$(spend_since "$(week_start)")"; printf "|%s" "$CABINET_BUDGET"' _ "$1" 2>/dev/null || true
}
budget_pct() { awk -v w="$1" -v b="$2" 'BEGIN { printf "%d", (b > 0 ? w * 100 / b : 100) }'; }   # budget_pct <spent> <budget>

digest_text() {  # digest_text <count> <rows>
  local n=$1 rows=$2 slug project ws exists written iso stale queue actions waiting spent budget pct
  ((n)) || { echo "${S_B}No cabinet workspaces on this machine yet.${S_Z} Start one: cabinet new, or cabinet init in an existing project."; return 0; }
  # Styled (platform.sh): headings bold without "== " and their folders dim, the date of the brief dim,
  # what waits on the owner yellow, notes blue.
  local hd="== " h
  [[ -z "$S_B" ]] || hd=""
  while IFS=$'\037' read -r slug project ws exists written iso stale queue actions waiting spent budget; do
    [[ -n "$slug" ]] || continue
    h="${S_D}(${ws/#$HOME/$TILDE})${S_Z}"
    if [[ "$exists" != ok ]]; then echo "$hd${S_B}$slug: folder gone${S_Z} $h${S_B}; cabinet list says how to free the slug${S_Z}"; echo; continue; fi
    echo "$hd${S_B}${project:-$slug}${S_Z} $h"
    if [[ -z "$written" ]]; then echo "${S_U}No brief yet${S_Z}. Write one: cd ${ws/#$HOME/$TILDE} && cabinet brief"
    else
      echo "Brief of ${S_D}$written${S_Z}$( [[ -n "$stale" ]] && echo ". ${S_U}Older than a day and a half${S_Z}: is the brief job running? cabinet doctor there")"
      echo
      if [[ "$queue" == $'\001' ]]; then echo "This brief has no \"## Sign-off queue\" heading: read BRIEF.md there."
      else
        echo "${S_Y}Sign-off queue:${S_Z}"; printf '%s\n' "${queue//$'\002'/$'\n'}" | sed '/./s/^/  /'
        if [[ -n "$actions" && "$actions" != None. ]]; then echo; echo "${S_Y}Actions for you:${S_Z}"; printf '%s\n' "${actions//$'\002'/$'\n'}" | sed '/./s/^/  /'; fi
      fi
    fi
    ((${waiting:-0})) && { echo; echo "${S_Y}$waiting handoff(s) wait on you${S_Z}: cd ${ws/#$HOME/$TILDE} && cabinet handoff list owner"; }
    if [[ -n "$spent" ]]; then
      echo
      if [[ -z "$budget" ]]; then echo "Agent runs this week: \$$spent, no budget set."
      else
        pct="$(budget_pct "$spent" "$budget")"
        if ((pct >= 80)); then echo "Agent runs this week: ${S_U}\$$spent of the \$$budget budget ($pct%)${S_Z}. What each job cost: cd ${ws/#$HOME/$TILDE} && cabinet job list"
        else echo "Agent runs this week: \$$spent of the \$$budget budget ($pct%)."; fi
      fi
    fi
    echo
  done <<<"$rows"
  echo "Answer each queue in its own workspace: cd there and give your agent the answers, for example \"1: approve; 2: no; 3: wait until Friday\"."
}

# The schedule, as the scheduler holds it: one place, nothing else to drift.
digest_schedule_line() {
  local pl args w; pl="$(sched_file "$DIGEST_LABEL")"
  if [[ ! -f "$pl" ]]; then echo "Not scheduled. To have it written for you: cabinet digest --schedule [--notify] (every day at 10:00 AM), or --schedule <when>"; return 0; fi
  args="$(sched_get "$pl" command | json -r '$.slice(2).join(" ")' 2>/dev/null)"
  w="$(sched_get "$pl" when)" && [[ -n "$w" ]] && w="$(when_human "$w")" || w="see $pl"
  echo "Scheduled, $w: cabinet digest ${args:-?}. Change: cabinet digest --schedule <when>; stop: cabinet digest --schedule off"
}

# digest_schedule <when>|off <file> <notify>: install, replace or remove this machine's digest schedule.
# <when>: a schedule time (bin/when.sh): "8 AM" every day, or "mon 8 AM", "sun,mon,tue,wed,thu 8 AM".
digest_schedule() {
  local when=$1 file=$2 notify=$3 pl; pl="$(sched_file "$DIGEST_LABEL")"
  if [[ "$(printf %s "$when" | tr '[:upper:]' '[:lower:]')" == off ]]; then
    [[ -f "$pl" ]] || { echo "The digest is not scheduled."; return 0; }
    sched_unload "$DIGEST_LABEL"
    echo "Stopped the scheduled digest. Its last file stays where it is."; return 0
  fi
  [[ "$SCHEDULER" != none ]] || die "no scheduler on this machine (a running systemd user session, or cron): install cron, or run cabinet digest --write <file> by hand"
  when_norm "$when" >/dev/null \
    || die "the digest time must be a time like \"8 AM\" for every day, or days and a time like \"fri 10 AM\" or \"sun,mon,tue,wed,thu 8 AM\" (day names in full work too)"
  when="$(when_norm "$when")"
  file="$(abspath "$file")"
  [[ "$file" != *[[:cntrl:]]* ]] || die "the digest file name cannot contain control characters"
  [[ $OS == mac ]] && case "$file" in "$HOME"/Documents/*|"$HOME"/Desktop/*|"$HOME"/Downloads/*|"$HOME/Library/Mobile Documents"/*)
    echo "Note: macOS may block a scheduled job from writing to $file until you allow it (System Settings > Privacy & Security > Files and Folders). $LOGROOT_SHOWN/ needs no permission." ;; esac
  local me; me="$(cd "$KIT" && pwd -P)/bin/cabinet"
  [[ "$me" == */_npx/* ]] && echo "Note: this cabinet runs from npx's cache, which npm can clear. For a schedule that lasts: npm i -g @tarekraafat/cabinet, then schedule again."
  # Scheduled jobs get a bare PATH: keep where git and node are now.
  local path="/usr/bin:/bin:/usr/sbin:/sbin" t text
  for t in git node; do t="$(command -v "$t" 2>/dev/null)" && [[ ":$path:" != *":${t%/*}:"* ]] && path="${t%/*}:$path"; done
  mkdir -p "$LOGROOT"
  if ((notify)); then text="$(sched_render "$DIGEST_LABEL" "$when" "$LOGROOT/digest.log" "$path" "$me" digest --write "$file" --notify)"
  else text="$(sched_render "$DIGEST_LABEL" "$when" "$LOGROOT/digest.log" "$path" "$me" digest --write "$file")"; fi
  if sched_load "$DIGEST_LABEL" "$text"; then
    echo "Scheduled the digest, $(when_human "$when"): it writes $file$( ((notify)) && echo " and sends a notification")."
    echo "Run it now to check: cabinet digest --write \"$file\"$( ((notify)) && echo " --notify")"
  else die "$SCHEDULER could not load the schedule (see above); nothing installed"; fi
}

# Every workspace on this machine, from the slug claims in <logs>/<slug>/workspace
# (written by setup and bootstrap): its version, what waits on the owner, the doctor's count
# and the newest brief. The doctors run side by side, each with its workspace's own scripts.
cmd_list() {
  local json=0 x
  for x in "$@"; do case "$x" in --json) json=1 ;; *) bad_usage "unknown option $x (see: cabinet list --help)" ;; esac; done
  local slug ws n=0 tmp
  LIST_TMP="$(mktemp -d)"; tmp="$LIST_TMP"; trap 'rm -rf "$LIST_TMP"' EXIT   # list is the whole run: clean up when it ends
  while IFS=$'\t' read -r slug ws; do
    n=$((n + 1)); printf '%s\t%s\n' "$slug" "$ws" > "$tmp/$n.row"
    if [[ -f "$ws/.cabinet/version" && -x "$ws/bin/doctor.sh" ]]; then
      ( "$ws/bin/doctor.sh" --json 2>/dev/null || true ) > "$tmp/$n.doctor" &
    fi
  done < <(known_workspaces)
  wait
  local i row project version waiting problems brief brief_iso exists
  : > "$tmp/all"
  for ((i = 1; i <= n; i++)); do
    IFS=$'\t' read -r slug ws < "$tmp/$i.row"
    project="" version="" waiting="" problems="" brief="" brief_iso="" exists=false
    if [[ -f "$ws/.cabinet/version" ]]; then
      exists=true; version="$(cat "$ws/.cabinet/version")"
      project="$( ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${CABINET_PROJECT:-}" ) )"
      waiting="$("$ws/bin/handoff.sh" list owner 2>/dev/null | grep -c '^### H-' || true)"
      problems="$(json -r '$.problems ?? undefined' "$tmp/$i.doctor" 2>/dev/null || true)"
      if [[ -f "$ws/BRIEF.md" ]]; then brief="$(human_mtime "$ws/BRIEF.md")"; brief_iso="$(date -u -r "$ws/BRIEF.md" +%Y-%m-%dT%H:%M:%SZ)"; fi
    fi
    # Unit separator, not tab: read keeps empty fields only with a separator that is not whitespace.
    printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$slug" "$project" "$ws" "$exists" "$version" "$waiting" "$problems" "$brief" "$brief_iso" >> "$tmp/all"
  done

  if ((json)); then
    json -R --arg kit "$VERSION" '$.map((l) => l.split("\u001f")).map((r) => ({slug: r[0], project: r[1], path: r[2], exists: r[3] == "true",
      version: str(r[4]), update_available: r[4] != "" && r[4] != $kit,
      waiting_on_owner: num(r[5]), doctor_problems: num(r[6]), brief_written: str(r[8])}))' "$tmp/all"
    return 0
  fi
  if ((n == 0)); then
    echo "${S_B}No cabinet workspaces on this machine yet.${S_Z} Start one: cabinet new, or cabinet init in an existing project."
    return 0
  fi
  local gone="" newer=0 v w p b
  echo "${S_B}Workspaces on this machine ($n):${S_Z}"
  # The table is built first, in this shell: a pipe would lose what the loop learns.
  {
    printf 'SLUG\tPROJECT\tKIT\tWAITING ON YOU\tDOCTOR\tLATEST BRIEF\tFOLDER\n'
    while IFS=$'\037' read -r slug project ws exists version waiting problems brief brief_iso; do
      if [[ "$exists" != true ]]; then
        printf '%s\t-\t-\t-\tfolder gone\t-\t%s\n' "$slug" "${ws/#$HOME/$TILDE}"; gone+=" $slug"; continue
      fi
      v="$version"; [[ "$version" != "$VERSION" ]] && { v="$version*"; newer=1; }
      w="${waiting:-?}"; [[ "$w" == 0 ]] && w="nothing" || w="$w handoff(s)"
      case "$problems" in 0) p="all good" ;; "") p="?" ;; *) p="$problems to fix" ;; esac
      b="${brief:-none yet}"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$slug" "${project:--}" "$v" "$w" "$p" "$b" "${ws/#$HOME/$TILDE}"
    done < "$tmp/all"
  } > "$tmp/table"
  # Aligned columns (column(1) is not on every Linux), padded from the plain text. Styled (platform.sh):
  # the header row, LATEST BRIEF and FOLDER dim, WAITING ON YOU yellow when something waits, DOCTOR
  # green or red; the codes sit outside the padding.
  awk -F'\t' -v d="$S_D" -v y="$S_Y" -v g="$S_G" -v r="$S_R" -v z="$S_Z" '
    function st(row, i, v) { if (z == "" || row == 1) return ""
      if (i == 4) return (v != "nothing" && v != "-") ? y : ""
      if (i == 5) return v == "all good" ? g : (v ~ / to fix$/ || v == "folder gone") ? r : ""
      return i >= 6 ? d : "" }
    function cell(row, i, v,   s) { s = st(row, i, v); return s == "" ? v : s v z }
    { for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } n[NR] = NF }
    END { for (row = 1; row <= NR; row++) { l = "  "
      for (i = 1; i < n[row]; i++) l = l cell(row, i, c[row, i]) sprintf("%" (w[i] - length(c[row, i]) + 2) "s", "")
      l = l cell(row, n[row], c[row, n[row]])
      print (row == 1 && z != "" ? "  " d substr(l, 3) z : l) } }' "$tmp/table"
  ((newer)) && echo "* not the installed kit ($VERSION): cabinet update in that workspace (after npm update there)."
  for slug in $gone; do
    echo "Folder gone for $slug: if it moved, run cabinet bootstrap in its new place; if it is deleted, free the slug with: rm -r $LOGROOT_SHOWN/$slug"
  done
  echo "Details: cabinet next (or cabinet doctor) inside a workspace."
  return 0
}

# Remove a workspace from this machine: its schedules, its log folder, its folder, and inside a
# project what setup added there. Shows the plan first; the guardrails stay (other
# workspaces use them); the backup key and archives stay unless --delete-key.
cmd_remove() {
  local dir="" yes=0 dry=0 force=0 delkey=0 x
  for x in "$@"; do
    case "$x" in --yes|-y) yes=1 ;; --dry-run) dry=1 ;; --force) force=1 ;; --delete-key) delkey=1 ;; *) bad_usage "unknown argument $x (see: cabinet remove --help; to name a workspace: cabinet -C <dir> remove)" ;; esac
  done
  local ws; ws="$(need_ws)" || exit 1
  [[ -f "$ws/.cabinet/version" && -f "$ws/cabinet.env" ]] || die "$ws is not a cabinet workspace"
  envget() { ( set +u; source "$ws/cabinet.env" >/dev/null 2>&1; printf '%s' "${!1:-}" ); }
  local slug layout vis host="" logs
  slug="$(envget CABINET_SLUG)"; layout="$(envget CABINET_LAYOUT)"; vis="$(envget CABINET_VISIBILITY)"
  [[ "$layout" == inside ]] && host="$(cd "$ws/.." && pwd -P)"
  logs="$LOGROOT/$slug"

  # Work that exists only here is never deleted silently.
  local git_ws="$ws" risk=""
  [[ "$layout" == inside && "$vis" == shared ]] && git_ws=""
  if [[ -n "$git_ws" && -e "$git_ws/.git" ]]; then
    [[ -n "$(git -C "$git_ws" status --porcelain 2>/dev/null)" ]] && risk+="it has uncommitted changes; "
    if git -C "$git_ws" rev-parse -q --verify HEAD >/dev/null 2>&1 && [[ -n "$(git -C "$git_ws" log --oneline --branches --not --remotes 2>/dev/null | head -1)" ]]; then
      risk+="it has commits that exist on no remote (its history would be lost); "
    fi
  fi

  echo "Removing the workspace $slug ($ws):"
  local scheds=() f
  for f in "$SCHED_DIR/ai.cabinet.$slug".*"$SCHED_EXT"; do [[ -f "$f" && "$(sched_ws "$f")" == "$ws" ]] && scheds+=("$(sched_label "$f")"); done
  ((${#scheds[@]})) && printf '  - stop and delete the schedule %s\n' "${scheds[@]}" || echo "  - no schedules to stop"
  [[ -f "$logs/workspace" && "$(cat "$logs/workspace")" == "$ws" ]] && echo "  - delete the log folder $logs (frees the slug)"
  if ((delkey)); then echo "  - delete the backup passphrase from the $PASS_STORE (cabinet.$slug.backup); archives stay"
  else echo "  - keep the backup passphrase (cabinet.$slug.backup) and any archives (--delete-key removes the key)"; fi
  if [[ -n "$host" && "$vis" == private ]]; then
    echo "  - in the project $host: remove the Agent team pointers setup added, the role files it built in .claude/agents/, and its .git/info/exclude lines"
  elif [[ -n "$host" ]]; then
    echo "  - in the project $host: remove the Agent team section and the @tarekraafat/cabinet devDependency (tracked files: commit the change yourself)"
  fi
  echo "  - delete the folder $ws"
  echo "  The guardrails in your agent tools stay: other workspaces use them."
  if [[ -n "$risk" ]]; then
    echo "Not safe to delete: ${risk%; }."
    ((force)) || die "push or copy that work first, or run again with --force to delete it anyway"
  fi
  ((dry)) && { echo "(dry run: nothing changed)"; return 0; }
  if ((yes == 0)); then
    { exec 3<"${CABINET_TTY:-/dev/tty}"; } 2>/dev/null || die "cabinet remove asks for confirmation: run it in a terminal, or add --yes"
    local typed=""; read -r -u 3 -p "Type the slug ($slug) to remove it: " typed || true
    [[ "$typed" == "$slug" ]] || die "nothing removed"
  fi

  for f in ${scheds[@]+"${scheds[@]}"}; do
    sched_unload "$f"; echo "  stopped $f"
  done
  if [[ -f "$logs/workspace" && "$(cat "$logs/workspace")" == "$ws" ]]; then rm -rf "$logs"; echo "  deleted $logs"; fi
  if ((delkey)); then pass_del "cabinet.$slug.backup" && echo "  deleted cabinet.$slug.backup from the $PASS_STORE" || echo "  no cabinet.$slug.backup in the $PASS_STORE"; fi
  if [[ -n "$host" ]]; then
    # Only what setup wrote: the section that names cabinet/CABINET.md, and generated role files.
    drop_section() {  # drop_section <file>: remove the "## Agent team" section that points at cabinet/
      [[ -f "$1" ]] && grep -qF 'cabinet/CABINET.md' "$1" || return 1
      node "$LIBJS" sub-all "$1" '/\n*## Agent team\n\n[^\n]*cabinet\/CABINET\.md[^\n]*\n?/' ''
      return 0
    }
    local ex; ex="$(git -C "$host" rev-parse --git-path info/exclude 2>/dev/null)"; [[ "$ex" == /* ]] || ex="$host/$ex"
    for f in "$host"/.claude/agents/*.md; do
      [[ -f "$f" ]] && grep -qxF "<!-- Generated by bin/role.sh build. Edit roles/$(basename "$f" .md).md, never this file. -->" "$f" || continue
      rm -f "$f"; [[ -f "$ex" ]] && node "$LIBJS" drop-line "$ex" "/.claude/agents/$(basename "$f")"
    done
    rmdir "$host/.claude/agents" "$host/.claude" 2>/dev/null || true
    if [[ "$vis" == private ]]; then
      for f in CLAUDE.local.md QWEN.local.md AGENTS.md; do
        git -C "$host" ls-files --error-unmatch "$f" >/dev/null 2>&1 && continue   # a tracked file is the project's own
        drop_section "$host/$f" || continue
        if [[ -z "$(tr -d '[:space:]' < "$host/$f")" ]]; then
          rm -f "$host/$f"; [[ -f "$ex" ]] && node "$LIBJS" drop-line "$ex" "/$f"
        fi
      done
      [[ -f "$ex" ]] && node "$LIBJS" drop-line "$ex" "/cabinet/"
      echo "  removed the pointers and exclude lines setup added in the project"
    else
      for f in AGENTS.md CLAUDE.md; do drop_section "$host/$f" && echo "  removed the Agent team section from $f (commit it)"; done
      if grep -q '@tarekraafat/cabinet' "$host/package.json" 2>/dev/null; then
        (cd "$host" && npm pkg delete "devDependencies[@tarekraafat/cabinet]") && echo "  removed the devDependency from package.json (commit it)"
      fi
    fi
  fi
  rm -rf "$ws"; echo "  deleted $ws"
  echo "Removed. The guardrails stay; see the kit's docs/guardrails.md to undo them."
}

# Is a newer kit published? Compares this workspace, the installed kit and the registry.
cmd_outdated() {
  local ws latest have="" json=0 x
  for x in "$@"; do case "$x" in --json) json=1 ;; *) bad_usage "unknown argument $x (see: cabinet outdated --help)" ;; esac; done
  ws="$(find_ws "")"; [[ -f "$ws/.cabinet/version" ]] && have="$(cat "$ws/.cabinet/version")"
  latest="$(npm view @tarekraafat/cabinet version 2>/dev/null)" || latest=""
  if ((json)); then
    json -n --arg w "$have" --arg k "$VERSION" --arg l "$latest" '({workspace_version: str($w), kit_version: $k, latest: str($l),
      update_available: $l == "" ? null : $l != $k || ($w != "" && $w != $k)})'
    return 0
  fi
  [[ -n "$have" ]] && echo "this workspace: cabinet $have"
  echo "installed kit: cabinet $VERSION"
  if [[ -z "$latest" ]]; then echo "latest: unknown (the registry could not be reached, or the package is not published there)"; return 0; fi
  echo "latest: cabinet $latest"
  if [[ "$latest" != "$VERSION" ]]; then echo "To take it: npm update in the workspace (npm i -g @tarekraafat/cabinet@latest for the global command), then cabinet update."
  elif [[ -n "$have" && "$have" != "$VERSION" ]]; then echo "The installed kit is newer than this workspace: cabinet update applies it."
  else echo "Up to date."; fi
}

# Tab completion for bash and zsh: eval "$(cabinet completion zsh)" in ~/.zshrc.
cmd_completion() {
  local shell="${1:-}" tops verbs arms
  [[ "$shell" == bash || "$shell" == zsh ]] || bad_usage "usage: cabinet completion bash|zsh"
  # zsh: start its completion system when ~/.zshrc has not, then load bash-style completion.
  [[ "$shell" == zsh ]] && echo '(( ${+functions[compdef]} )) || { autoload -Uz compinit && compinit -i; }; autoload -U +X bashcompinit && bashcompinit'
  tops="$(commands_table | awk -F'\t' '$1 == "C" {split($3, w, " "); if (!(w[1] in s)) {s[w[1]] = 1; printf "%s%s", (n++ ? " " : ""), w[1]}}')"
  verbs="$(commands_table | awk -F'\t' '$1 == "C" && index($3, " ") {split($3, w, " "); v[w[1]] = v[w[1]] " " w[2]}
    END {for (k in v) printf "        %s) words=\"%s\" ;;\n", k, substr(v[k], 2)}' | sort)"
  arms="$(commands_table | awk -F'\t' '$1 == "O" {n = split($2, c, ","); for (i = 1; i <= n; i++) o[c[i]] = o[c[i]] " " $3}
    END {for (k in o) printf "        \"%s\") words=\"%s\" ;;\n", k, substr(o[k], 2)}' | sort)"
  cat <<EOF
_cabinet() {
  local cur="\${COMP_WORDS[COMP_CWORD]}" prev="\${COMP_WORDS[COMP_CWORD-1]}" i=1 words=""
  # Skip -C <dir> before the command.
  [[ "\${COMP_WORDS[1]}" == -C ]] && i=3
  local w1="\${COMP_WORDS[i]}" cmd="\${COMP_WORDS[i]}"
  if ((COMP_CWORD == i)); then words="$tops"; [[ \$i == 1 ]] && words+=" -C"
  elif ((COMP_CWORD == i + 1)) && [[ " $(commands_table | awk -F'\t' '$1 == "C" && index($3, " ") {split($3, w, " "); printf "%s ", w[1]}') " == *" \$w1 "* ]]; then
    case "\$w1" in
$verbs
    esac
  else
    [[ " $(commands_table | awk -F'\t' '$1 == "C" && index($3, " ") {split($3, w, " "); printf "%s ", w[1]}') " == *" \$w1 "* ]] && cmd="\$w1 \${COMP_WORDS[i+1]}"
    case "\$prev" in
      --runner) words="$RUNNERS custom" ;;
      --roles) words="$ROLES_ALL $ROLES_OPT" ;;
      --week-start) words="$DAYS" ;;
      --brief-time) words="7am 8am 9am off" ;;
      completion) words="bash zsh" ;;
      help) words="$tops" ;;
    esac
    if [[ -z "\$words" ]]; then
      case "\$cmd" in
$arms
        "job run")  # the jobs of the nearest workspace, from here upward
          local d="\$PWD" j
          while [[ -n "\$d" ]]; do
            [[ -f "\$d/cabinet/.cabinet/version" ]] && d="\$d/cabinet"
            if [[ -f "\$d/.cabinet/version" ]]; then
              for j in "\$d"/jobs/*.job; do [[ -f "\$j" ]] && j="\${j##*/}" && words+=" \${j%.job}"; done
              break
            fi
            [[ "\$d" == / ]] && break; d="\$(dirname "\$d")"
          done ;;
      esac
    fi
  fi
  [[ -n "\$words" ]] && COMPREPLY=(\$(compgen -W "\$words" -- "\$cur"))
}
complete -o default -F _cabinet cabinet
EOF
}

# The mark: seven seats around a table, the eighth left open for the owner. Only in a
# terminal, so a script that reads `cabinet version` still gets the one line.
version_mark() {
  local o=o
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) o="⬤" ;; esac
  # Seven rows for a radius of three: a terminal cell is about twice as tall as it is wide.
  # The tagline as brand/BRAND.md approves it, on two lines beside the open place.
  printf '\n      %s\n  %s       %s\n\n%s               cabinet %s\n                One person, a whole team.\n  %s       %s     Build anything with AI agents, and stay in charge.\n      %s\n\n' \
    "$o" "$o" "$o" "$o" "$VERSION" "$o" "$o" "$o"
}
cmd_version() {
  case "${1:-}" in "") if [[ -t 1 ]]; then version_mark; else echo "cabinet $VERSION"; fi ;; --json) json -n --arg v "$VERSION" '({name: "cabinet", version: $v})' ;; *) bad_usage "unknown argument $1 (see: cabinet version --help)" ;; esac
}
cmd_changelog() {
  local from="" json=0 x
  for x in "$@"; do case "$x" in --json) json=1 ;; -*) bad_usage "unknown option $x (see: cabinet changelog --help)" ;; *) from="$x" ;; esac; done
  if ((json)); then
    # One record per version: its number, its date as written ("Unreleased" until released), and its text.
    changelog "$from" | awk '/^## [0-9]/ {if (v != "") printf "%s\t%s\t%s\n", v, d, t; v = $2; d = $0; sub(/^## [^ ]+ - /, "", d); t = ""; next}
      {gsub(/\t/, " "); t = t $0 "\001"} END {if (v != "") printf "%s\t%s\t%s\n", v, d, t}' \
      | json -R '$.map((l) => l.split("\t")).map((r) => ({version: r[0], date: r[1], text: r[2].replaceAll("\u0001", "\n").replace(/^\n+/, "").replace(/\n+$/, "")}))'
    return 0
  fi
  changelog "$from" | changelog_show
}
cmd_update() {
  [[ $# -eq 0 ]] || bad_usage "cabinet update takes no arguments (to name a workspace: cabinet -C <dir> update)"
  local ws; ws="$(find_ws "")"
  [[ -f "$ws/.cabinet/version" ]] || die "$ws is not a cabinet workspace (no .cabinet/version)"
  local old; old="$(cat "$ws/.cabinet/version")"
  # The update is committed when the workspace has its own git and the files it rewrites held no edits
  # of the owner's before (the pin in package.json and its lockfile, from npm update, go with it).
  local pth
  local kit_paths=()
  for pth in .cabinet CABINET.md bin agents .claude/agents ORG.md; do [[ -e "$ws/$pth" ]] && kit_paths+=("$pth"); done
  local clean=0
  [[ "$(cd "$(git -C "$ws" rev-parse --show-toplevel 2>/dev/null || echo /nonexistent)" 2>/dev/null && pwd -P)" == "$(cd "$ws" && pwd -P)" &&
     -z "$(git -C "$ws" status --porcelain -- "${kit_paths[@]}" 2>/dev/null)" ]] && clean=1
  local hd="== "; [[ -z "$S_B" ]] || hd=""   # styled: headings bold, without "== "
  echo "$hd${S_B}cabinet $old -> $VERSION in $ws${S_Z}"
  if sync_kit "$ws"; then
    echo "$VERSION" > "$ws/.cabinet/version"
  else
    echo
    echo "${S_R}Some kit files were edited here${S_Z} and were not replaced, so the version stays $old."
    echo "Move each change into a project file (AGENTS.md, roles/, jobs/) or into the kit, restore the file"
    echo "(git -C \"$ws\" checkout -- <file>), then run cabinet update again."
    exit 1
  fi
  "$ws/bin/role.sh" build
  [[ ! -f "$ws/OPERATIONS.md" ]] || "$ws/bin/manual.sh" build >/dev/null || echo "OPERATIONS.html not built (bin/manual.sh build)"
  if [[ "$old" != "$VERSION" ]]; then
    echo
    echo "$hd${S_B}What changed since $old${S_Z}"
    changelog "$old" | changelog_show
  fi
  echo
  # Name only the paths that exist here; a pin in the project above is the project's own commit.
  local paths="" f
  local files=()
  for pth in .cabinet CABINET.md bin agents .claude/agents ORG.md package.json package-lock.json; do [[ -e "$ws/$pth" ]] && paths+=" $pth"; done
  while IFS= read -r f; do files+=("$f"); done < <(git -C "$ws" status --porcelain -- $paths 2>/dev/null | cut -c4-)
  # package.json goes in only when the pin is its one change; any other edit there is the owner's to commit.
  local own_pkg=0
  if [[ -n "$(git -C "$ws" diff HEAD -U0 -- package.json 2>/dev/null | grep '^[-+][^-+]' | grep -vF '"@tarekraafat/cabinet"')" ]]; then
    own_pkg=1
    local kept=()
    for f in ${files[@]+"${files[@]}"}; do [[ "$f" == package.json || "$f" == package-lock.json ]] || kept+=("$f"); done
    files=(${kept[@]+"${kept[@]}"})
  fi
  if ((clean)) && ((${#files[@]})) && git -C "$ws" add -A -- "${files[@]}" 2>/dev/null &&
     git -C "$ws" -c commit.gpgsign=false commit -q -m "cabinet: update to $VERSION" -- "${files[@]}" >/dev/null 2>&1; then
    echo "${S_G}Committed in the workspace${S_Z}: cabinet: update to $VERSION. Anything to do by hand is in the changelog above."
    ((own_pkg)) && echo "package.json has edits of yours besides the pin, so it was left out: git -C \"$ws\" commit -- package.json$([[ -n "$(git -C "$ws" ls-files -- package-lock.json 2>/dev/null)" ]] && echo " package-lock.json")"
  elif ((${#files[@]} == 0)) && [[ "$old" == "$VERSION" ]]; then
    echo "${S_G}Nothing changed${S_Z}: the workspace was already on $VERSION."
  elif ((${#files[@]} == 0)); then
    # No git of its own here (or a private cabinet/ the project ignores): nothing to commit.
    echo "${S_G}Updated to${S_Z} $VERSION. Anything to do by hand is in the changelog above."
  else
    echo "Review the diff (git -C \"$ws\" diff), do anything the changelog says to do by hand,"
    echo "then commit: git -C \"$ws\" add --$paths && git -C \"$ws\" commit -m \"cabinet: update to $VERSION\""
  fi
  if [[ -f "$ws/../package.json" && ! -f "$ws/package.json" ]] && grep -q '@tarekraafat/cabinet' "$ws/../package.json" 2>/dev/null; then
    echo "The pin lives in the project: commit its package.json and lockfile there."
  fi
}

cmd_status() {
  local json=0 dir="" x
  for x in "$@"; do case "$x" in --json) json=1 ;; *) bad_usage "unknown argument $x (see: cabinet status --help)" ;; esac; done
  local ws; ws="$(find_ws "")"
  [[ -f "$ws/.cabinet/version" ]] || die "$ws is not a cabinet workspace"
  local h p
  local edited=()
  while read -r h p; do
    [[ -z "${p:-}" ]] && continue
    [[ -f "$ws/$p" && "$(sha256 "$ws/$p")" == "$h" ]] || edited+=("$p")
  done < "$ws/.cabinet/manifest"
  if ((json)); then
    printf '%s\n' ${edited[@]+"${edited[@]}"} | json -R --arg ws "$ws" --arg have "$(cat "$ws/.cabinet/version")" --arg kit "$VERSION" --arg kitdir "$KIT" \
      '({workspace: $ws, version: $have, kit_version: $kit, kit: $kitdir, edited: $.filter(Boolean)})'
    return 0
  fi
  echo "workspace $ws: cabinet $(cat "$ws/.cabinet/version"); kit at $KIT: $VERSION"
  ((${#edited[@]})) && printf "  ${S_U}edited here${S_Z}: %s\n" "${edited[@]}" || echo "  ${S_G}no kit file edited${S_Z}"
}

# --help (or -h) after any command: its usage and options, from the table. A noun alone, or a
# noun with --help, shows its verbs.
if [[ -n "${1:-}" && "$1" != help ]]; then
  for x in "${@:2}"; do
    [[ "$x" == --help || "$x" == -h ]] || continue
    if is_cmd "$1 ${2:-}"; then cmd_help "$1 $2"; exit 0; fi
    if is_cmd "$1" || is_noun "$1"; then cmd_help "$1"; exit 0; fi
  done
fi

case "${1:-}" in
  new) shift; deps_gate "$@"; cmd_new "$@" ;;
  init) shift; deps_gate "$@"; cmd_init "$@" ;;
  next) shift; cmd_next "$@" ;;
  brief) shift; ws_script job.sh run brief "$@" ;;
  digest) shift; cmd_digest "$@" ;;
  list) shift; cmd_list "$@" ;;
  doctor) shift; ws_script doctor.sh "$@" ;;
  role) shift; cmd_role "$@" ;;
  handoff) shift; noun_script handoff "$@" ;;
  spec) shift; noun_script spec "$@" ;;
  manual) shift; noun_script manual "$@" ;;
  repo) shift; cmd_repo "$@" ;;
  job) shift; noun_script job "$@" ;;
  secret) shift; noun_script secret "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  bootstrap) shift; deps_gate "$@"; ws_script bootstrap.sh "$@" ;;
  config) shift; cmd_config "$@" ;;
  move) shift; ws_script move.sh "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  update) shift; cmd_update "$@" ;;
  status) shift; cmd_status "$@" ;;
  outdated) shift; cmd_outdated "$@" ;;
  changelog) shift; cmd_changelog "$@" ;;
  completion) shift; cmd_completion "$@" ;;
  version|--version|-v) shift; cmd_version "$@" ;;
  help) shift; cmd_help "$@" ;;
  --help|-h|"") cmd_help ;;
  *)
    # A short answer, not the whole help: the closest command when one is near (two words typed as one
    # included), and where the full list is.
    if [[ "$1" == *" "* ]] && is_cmd "$1"; then guess="$1"
    else guess="$(node "$LIBJS" closest "$1" $(commands_table | awk -F'\t' '$1 == "C" { split($3, w, " "); if (!(w[1] in s)) { s[w[1]] = 1; print w[1] } }'))"; fi
    echo "$ERR_TAG unknown command '$1'" >&2
    [[ -z "$guess" ]] || echo "Did you mean: cabinet $guess" >&2
    echo "Every command: cabinet help" >&2
    exit 2 ;;
esac
