# @@PROJECT@@ settings for the cabinet kit. Sourced by every bin/*.sh.
# Project-owned: kit updates never change it; `cabinet config` edits it for you.

CABINET_PROJECT="@@PROJECT@@"
# Scopes everything machine-wide: schedules ai.cabinet.<slug>.<job>, logs
# ~/Library/Logs/cabinet/<slug>/ (macOS) or ~/.local/state/cabinet/<slug>/ (Linux),
# the backup passphrase item cabinet.<slug>.backup in the keychain or secret store.
CABINET_SLUG="@@SLUG@@"

# Kit roles this project uses, plus any project-only role defined whole in roles/.
# Change roles with `cabinet config --roles "..."` (it rebuilds them and the team tables),
# or edit here, then run bin/role.sh build and update the team tables in AGENTS.md and OPERATIONS.md.
CABINET_ROLES="chief-of-staff product-manager architect qa security design-lead finance"

# The agent tool that runs scheduled jobs: claude, codex, antigravity, qwen, grok,
# opencode, cursor (the Cursor CLI), or custom. Custom runs CABINET_RUNNER_CMD with the prompt in
# $CABINET_PROMPT and the role in $CABINET_AGENT, e.g. 'mytool --run "$CABINET_PROMPT"'.
CABINET_RUNNER="claude"
CABINET_RUNNER_CMD=""

# Set by cabinet new or init. Layout: new, around (an existing folder),
# inside (cabinet/ in a project) or beside (next to a project).
CABINET_LAYOUT="new"
# Inside only: private (its own git, ignored by the project) or shared (committed with it).
CABINET_VISIBILITY=""

# Daily encrypted backup. Empty turns it off. Never a folder inside the workspace.
CABINET_BACKUP_DIR=""
CABINET_BACKUP_TIME="1:00 PM"
CABINET_BACKUP_KEEP=14

# Minutes a scheduled job may run before it is stopped, for jobs without their own TIMEOUT.
# 0 for no limit.
CABINET_JOB_TIMEOUT=60

# A weekly budget in US dollars for the agent runs cabinet starts (scheduled jobs, role drafts),
# counted from what the agent tool reports (see CABINET_PRICE); the doctor warns from 80%. Empty: none.
# Change it with `cabinet config --budget <dollars>|off`.
CABINET_BUDGET=""
# Dollars per million tokens, "<input> <output> [<cached input>]", for a runner that reports only
# tokens (codex, cursor, qwen, antigravity); claude, grok and opencode report dollars themselves.
# `cabinet config --price "1.25 10 0.125"`. Empty: those runs are not counted.
CABINET_PRICE=""

# Skills and plugins bin/doctor.sh expects (space separated; a miss is a note).
CABINET_SKILLS=""
CABINET_PLUGINS=""
