# The daily brief. Run now: cabinet brief
# WHEN: a time every day, "7:00 AM", or days and a time: "fri 4:00 PM", "sun,mon,tue,wed,thu 8:00 AM"
# (full day names work too). Empty: only by hand.
# After changing WHEN, or deleting this file: cabinet bootstrap adds, updates or removes the schedule.
AGENT=chief-of-staff
WHEN="7:00 AM"
MINUTES="5 to 15"
RESULT="BRIEF.md"
# TIMEOUT: minutes before a run is stopped. Empty: CABINET_JOB_TIMEOUT in cabinet.env (60). 0: no limit.
TIMEOUT=""
# QUIET_DAYS: a scheduled run skips the agent when nothing changed since the last full run: no commit,
# branch, fetch or uncommitted change in the workspace or a repo, no new doctor problem, and BRIEF.md
# as that run left it. Never while the sign-off queue holds a "default" item. At most this many days
# in a row, then a full run. 0: run every time.
QUIET_DAYS="6"
PROMPT="Scheduled daily run. Write BRIEF.md as your definition says, sign-off queue first. Apply any answered queue items. Commit your HANDOFFS.md changes and any leftover finished handoff lines, then run bin/handoff.sh archive, as CABINET.md says."
# AFTER: an optional shell command run in the workspace after a successful run.
AFTER=""
