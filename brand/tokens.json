{
  "name": "cabinet",
  "about": "The cabinet brand as data. The rules and their status are in brand/BRAND.md; tools/build-brand.py builds brand/assets/ from this file.",
  "color": {
    "ink": { "value": "#15181E", "use": "Seats, text, the name.", "status": "draft" },
    "paper": { "value": "#F3F4F6", "use": "Backgrounds and the logo tile.", "status": "approved" },
    "white": { "value": "#FFFFFF", "use": "Cards and documents on paper.", "status": "draft" },
    "night": { "value": "#101216", "use": "Dark backgrounds, slides, the app icon.", "status": "draft" },
    "mist": { "value": "#E8EAEE", "use": "Seats and text on night.", "status": "draft" },
    "slate": { "value": "#5C6370", "use": "Secondary text and captions.", "status": "draft" },
    "line": { "value": "#D9DCE2", "use": "Borders and dividers on light backgrounds.", "status": "draft" },
    "brass": { "value": "#A06F17", "use": "The owner's open seat, on light backgrounds. Nothing else.", "status": "draft" },
    "brass-light": { "value": "#D7A54B", "use": "The owner's open seat, on dark backgrounds. Nothing else.", "status": "draft" }
  },
  "share": { "paper and white": 0.60, "ink": 0.30, "slate and line": 0.09, "brass": 0.01 },
  "status_color": {
    "ok": { "light": "#2F7D4F", "dark": "#6CC08B", "terminal": "green", "means": "Nothing to do." },
    "note": { "light": "#2F6FB3", "dark": "#7FB0E8", "terminal": "blue", "means": "Worth knowing, nothing broken (the warning)." },
    "fix": { "light": "#B3261E", "dark": "#F2867D", "terminal": "red", "means": "A problem; the message names the command that fixes it." },
    "status": "approved"
  },
  "font": {
    "display": { "family": "Schibsted Grotesk", "weight": 700, "tracking_em": -0.035, "use": "The name and headings (headings at -0.02em).", "status": "draft" },
    "body": { "family": "Schibsted Grotesk", "weight": 400, "size_px": [15, 17], "use": "Running text.", "status": "draft" },
    "mono": { "family": "JetBrains Mono", "weight": 400, "use": "Commands, files and labels.", "status": "draft" },
    "license": "Both are free under the SIL Open Font License 1.1, on Google Fonts."
  },
  "mark": {
    "grid": 100,
    "places": 8,
    "open_place_degrees": 0,
    "ring_radius": 36,
    "seat_diameter": 19,
    "outline": { "radius": 8.4, "stroke": 2.2 },
    "tile": { "radius": 22, "mark_scale": 0.66 },
    "clear_space": "one seat diameter on every side",
    "min_size_px": 16,
    "status": "approved"
  },
  "chairs": { "seat": 14.8, "min_size_px": 96, "status": "approved" },
  "table": { "opacity": 0.12, "radius": 17, "status": "approved" },
  "terminal_mark": { "lines": 7, "columns": 13, "dot": "U+25CF", "ascii_dot": "o", "status": "approved" },
  "motion": { "hover_reveal_ms": 400, "chair_step_ms": [400, 800], "status": "draft" }
}
