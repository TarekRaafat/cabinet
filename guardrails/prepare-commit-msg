#!/bin/sh
# cabinet credit hook v9
# Credit roles (cabinet config --credit-roles on): a commit made in a Cabinet run ends with one line,
#   Co-authored-by: Cabinet <role> <email>
# naming the role of that run. A run sets CABINET_AGENT, CABINET_CREDIT and CABINET_CREDIT_ADDRESS
# (run_agent in bin/lib.sh); a commit made anywhere else has none of them, so it gets nothing. Each value
# is checked here and none reaches a shell. Only new commits: never an amend, merge or squash, nor a
# commit a rebase or cherry-pick replays. First, as the pass-through stub does, the repo's own
# prepare-commit-msg runs with the same arguments, and its failure still stops the commit.
# Unattended runs never rewrite: in a Cabinet run (CABINET_AGENT set), every amend is refused, since no
# owner is there to ask for one. git gives an amend the source "commit" (as it gives -c and -C <commit>,
# refused too), but "message" with -m or -F, as it gives a new commit: so the arguments of the git command
# that runs this hook (its parent process) are read too, for --amend or an abbreviation of it given as an
# argument of its own. On Linux each argument is read on its own. ps (elsewhere) joins them with spaces, so
# there each line of a -m message that stands in them as words of its own is taken out first, and a -m
# message that mentions --amend or --amount is a new commit. One it cannot take out (a tab, say) is still
# read as an amend, and each refusal says to give the message with -F <file>.
# An agent amends its own commit as CABINET_AMEND_AS=<role> git commit --amend: the amend is refused unless
# HEAD's message holds exactly one Cabinet credit line, as its last line, for that role, so no agent
# rewrites another role's commit or the owner's. The role is compared as it is written, before anything is
# stripped for the message. An allowed amend keeps that line. With neither variable set (the owner in a
# terminal) nothing is checked: a guard against a mistake, not a lock.
# Placed by bin/bootstrap.sh in the global hooks folder; line 2 is its version, which bootstrap reads to
# replace an earlier one (keeping an edited one first as prepare-commit-msg.cabinet-v<N>). An edited copy of
# this version is left as it is, and the doctor says credit is not installed.
# No foreign attribution: a new commit made with CABINET_AGENT set to a role name (a run, or an agent outside
# one committing as CABINET_AGENT=<role>) is refused when the message's ending holds a Co-authored-by line other
# than Cabinet's own for that role, a Claude-Session line, or a line holding "Generated with", in any case. The
# ending is read from the last line up, comments skipped, while a line is blank, a trailer or holds "Generated
# with"; the body above it, and a -v diff below the scissors line, are never read. With CABINET_AGENT unset (the
# owner in a terminal) nothing is checked, credit on or off. A refused line is printed as data, never run.
own="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/prepare-commit-msg"
if [ -x "$own" ] && ! [ "$own" -ef "$0" ]; then "$own" "$@" || exit $?; fi

# amend_arg <message file>: an amend in the git command's arguments, one argument --am, --ame, --amen or
# --amend. From /proc on Linux. Elsewhere from what ps prints (the arguments joined by spaces, a newline
# inside one as \012): each line of the message is taken out once where it stands between spaces, then
# the words are matched. Only text a -m gives may be taken out: a line of the file that did not come from
# the arguments could take out the real --amend. So nothing is taken out when any word could be a -F or
# --file option (--fil..., or a short group holding F, even inside a message), and reading stops at the
# first comment line (one starting with # or the comment character, as the scissors line of -v does),
# since git writes nothing from -m below one. Both only ever give more refusals. Anything but a clean
# "no amend" from awk (the file unreadable, say) is an amend.
# comment_chars: the characters a comment line can start with (# and git's comment character, or every one
# git may pick for auto).
comment_chars() {
  cc="$(git config core.commentString 2>/dev/null || git config core.commentChar 2>/dev/null)"
  case "$cc" in auto) printf '%s' '#;@!$%^&|:' ;; *) printf '#%s' "$(printf '%s' "$cc" | cut -c1)" ;; esac
}
amend_arg() {
  if [ -r "/proc/$PPID/cmdline" ]; then tr '\000' '\n' < "/proc/$PPID/cmdline" | grep -qxE -e '--am(e(n(d)?)?)?'; return; fi
  CABINET_PS_CC="$(comment_chars)" CABINET_PS_ARGS=" $(ps -ww -o args= -p "$PPID" 2>/dev/null) " awk '
    BEGIN { a = ENVIRON["CABINET_PS_ARGS"]; gsub(/\\012/, " ", a); cc = ENVIRON["CABINET_PS_CC"]
      n = split(a, w, " "); for (k = 1; k <= n; k++) if (w[k] ~ /^--fil/ || w[k] ~ /^-[^-]*F/) stop = 1 }
    !stop && $0 != "" && index(cc, substr($0, 1, 1)) { stop = 1 }
    !stop { sub(/[ \t]+$/, ""); if ($0 != "" && (i = index(a, " " $0 " "))) a = substr(a, 1, i) substr(a, i + length($0) + 1) }
    END { n = split(a, w, " "); for (k = 1; k <= n; k++) if (w[k] ~ /^--am(e(n(d)?)?)?$/) exit 0; exit 1 }' "$1" 2>/dev/null
  [ $? -ne 1 ]
}
amend() { [ "${2:-}" = commit ] && return 0; amend_arg "${1:-}"; }
if [ -n "${CABINET_AGENT:-}" ] && amend "$@"; then
  echo "cabinet: no amend in a Cabinet run: no owner is there to ask for one. Commit the fix as a new commit. If this is a new commit whose message mentions --amend, give the message with -F <file> instead of -m." >&2
  exit 1
fi

LC_ALL=C; export LC_ALL
nl='
'
# one <value> <pattern>: the value is one line that matches the whole pattern.
one() { case "$1" in *"$nl"*) return 1 ;; esac; printf '%s\n' "$1" | grep -qxE "$2"; }
# has_text <file>: the message holds a line that is neither a comment nor blank.
has_text() { grep -q -v -e '^#' -e '^[[:space:]]*$' "$1" 2>/dev/null; }

as="${CABINET_AMEND_AS:-}"
mf=" If this is a new commit whose message mentions --amend, give the message with -F <file> instead of -m."
if [ -n "$as" ] && amend "$@"; then
  if ! one "$as" '[a-z][a-z0-9-]*'; then
    echo "cabinet: no amend: CABINET_AMEND_AS is not a role name. Commit the fix as a new commit.$mf" >&2
    exit 1
  fi
  head="$(git log -1 --format=%B HEAD 2>/dev/null)"
  n="$(printf '%s\n' "$head" | grep -c '^Co-authored-by: Cabinet ')"
  last="$(printf '%s\n' "$head" | grep -v '^[[:space:]]*$' | tail -n 1)"
  why=""
  case "$last" in
    "Co-authored-by: Cabinet "*) r="${last#Co-authored-by: Cabinet }"; r="${r%% *}" ;;
    *) why="HEAD has no Cabinet credit line at the end" ;;
  esac
  # More than one line wins over any other reason: the guard cannot tell whose commit it is.
  if [ "$n" -gt 1 ]; then why="HEAD has more than one Cabinet credit line"
  elif [ -z "$why" ] && [ "$r" != "$as" ]; then why="HEAD is $(printf '%s' "$r" | tr -cd '[:graph:]')'s commit"; fi
  if [ -n "$why" ]; then
    echo "cabinet: no amend as $as: $why. Commit the fix as a new commit.$mf" >&2
    exit 1
  fi
  # Allowed: the new message keeps HEAD's line, added once; an empty one stays empty, so git still refuses it.
  has_text "$1" || exit 0
  git interpret-trailers --in-place --where end --if-exists addIfDifferent --trailer "$last" "$1" 2>/dev/null || :
  exit 0
fi

# Only a new commit is checked or credited: never a merge, squash or reused message, nor a replayed one.
case "${2:-}" in ""|message|template) ;; *) exit 0 ;; esac
dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
for s in rebase-merge rebase-apply CHERRY_PICK_HEAD; do [ -e "$dir/$s" ] && exit 0; done
role="${CABINET_AGENT:-}"
if one "$role" '[a-z][a-z0-9-]*'; then
  # The foreign lines of the ending, in message order. The three patterns are the three lines of foreign().
  bad="$(CABINET_CC="$(comment_chars)" awk -v role="$role" '
    function gw(l,  s, i) { s = tolower(l); while ((i = index(s, "generated with"))) { if (i == 1 || substr(s, i - 1, 1) !~ /[a-z]/) return 1; s = substr(s, i + 1) } return 0 }
    function key(l) { return l ~ /^[A-Za-z0-9-]+: / ? tolower(substr(l, 1, index(l, ":") - 1)) : "" }
    function foreign(l,  v) { v = substr(l, index(l, ":") + 2); sub(/[ \t\r]+$/, "", v)
      if (key(l) == "co-authored-by" && v !~ ("^Cabinet " role " <[^<> ]+>$")) return 1
      if (key(l) == "claude-session") return 1
      if (gw(l)) return 1
      return 0 }
    BEGIN { cc = ENVIRON["CABINET_CC"] }
    $0 != "" && index(cc, substr($0, 1, 1)) && substr($0, 2) == " ------------------------ >8 ------------------------" { exit }
    $0 != "" && index(cc, substr($0, 1, 1)) { next }
    { line[++n] = $0 }
    END { for (k = n; k >= 1; k--) { l = line[k]; if (l !~ /^[ \t\r]*$/ && key(l) == "" && !gw(l)) break; if (foreign(l)) out[++m] = l }
      for (k = m; k >= 1; k--) print out[k] }' "$1" 2>/dev/null)" || { echo "cabinet: commit refused: the message could not be read to check it for attribution." >&2; exit 1; }
  if [ -n "$bad" ]; then
    printf '%s\n' "$bad" | while IFS= read -r l; do
      printf 'cabinet: commit refused: "%s" is attribution other than Cabinet'"'"'s own credit\n' "$l" >&2
    done
    echo "Commit again without it: Cabinet adds its own credit line." >&2
    exit 1
  fi
fi

[ "${CABINET_CREDIT:-}" = on ] || exit 0
# email_for <role>: the one place in this hook the email of a role's line is chosen, into $email. Today
# it is the same for every role: the address the run passes (run_agent picks it), else the Cabinet Team account's.
email_for() {
  email="${CABINET_CREDIT_ADDRESS:-}"
  [ -n "$email" ] || email='350503452+cabinet-team@users.noreply.github.com'
}
one "$role" '[a-z][a-z0-9-]*' || exit 0
email_for "$role"
one "$email" '[0-9]+\+([a-z0-9]+(-[a-z0-9]+)*\[bot\]|[A-Za-z0-9]+(-[A-Za-z0-9]+)*)@users\.noreply\.github\.com' || exit 0
# An empty message (comments aside) stays empty, so git still refuses it.
has_text "$1" || exit 0
git interpret-trailers --in-place --where end --if-exists addIfDifferent \
  --trailer "Co-authored-by: Cabinet $role <$email>" "$1" 2>/dev/null || :
exit 0
