#!/bin/sh
# cabinet: refuse a commit that adds a likely key, token or password to the workspace
# (bin/secret.sh check --staged). Placed in the workspace's own .git/hooks by bin/bootstrap.sh.
# A commit the scan cannot check is refused too: a missing scanner never lets one through.
top="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$top" ] || [ ! -x "$top/bin/secret.sh" ]; then
  echo "commit refused: bin/secret.sh is missing or not executable, so this commit cannot be checked for secrets (run bin/doctor.sh)" >&2
  exit 1
fi
exec "$top/bin/secret.sh" check --staged
