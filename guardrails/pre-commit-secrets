#!/bin/sh
# cabinet: refuse a commit that adds a likely key, token or password to the workspace
# (bin/secrets.sh --staged). Placed in the workspace's own .git/hooks by bin/bootstrap.sh.
top="$(git rev-parse --show-toplevel)" || exit 0
[ -x "$top/bin/secrets.sh" ] || exit 0
exec "$top/bin/secrets.sh" --staged
