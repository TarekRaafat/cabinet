{
  "permissions": {
    "deny": [
      "Shell(git:push*)",
      "Shell(git:send-pack*)",
      "Shell(git:*ooksPath*)",
      "Shell(git:*ookspath*)",
      "Shell(git:*--no-v*)",
      "Shell(script)",
      "Shell(expect)",
      "Shell(unbuffer)",
      "Shell(env)",
      "Shell(bash:-c*)",
      "Shell(sh:-c*)",
      "Shell(zsh:-c*)",
      "Shell(nohup)",
      "Shell(xargs)",
      "Shell(sudo)",
      "Shell(exec)",
      "Shell(command)",
      "Shell(nice)",
      "Shell(stdbuf)",
      "Shell(timeout:*push*)",
      "Shell(timeout:*publish*)",
      "Shell(timeout:*send-pack*)",
      "Shell(time:*push*)",
      "Shell(time:*publish*)",
      "Shell(time:*send-pack*)",
      "Shell(gh:pr merge*)",
      "Shell(gh:* pr merge*)",
      "Shell(gh:release*)",
      "Shell(gh:* release*)",
      "Shell(gh:repo edit*)",
      "Shell(gh:repo archive*)",
      "Shell(gh:repo delete*)",
      "Shell(gh:repo rename*)",
      "Shell(gh:api*-X*)",
      "Shell(gh:api* --method*)",
      "Shell(gh:api* -f*)",
      "Shell(gh:api* -F*)",
      "Shell(gh:api* --field*)",
      "Shell(gh:api* --raw-field*)",
      "Shell(gh:api* --input*)",
      "Shell(gh:auth token*)",
      "Shell(gh:auth status*--show-token*)",
      "Shell(npm:*publish*)",
      "Shell(npx:npm publish*)",
      "Shell(bun:*publish*)",
      "Shell(pnpm:*publish*)",
      "Shell(yarn:*publish*)",
      "Shell(security:find-generic-password*)",
      "Shell(security:dump-keychain*)",
      "Shell(secret-tool:lookup*)",
      "Shell(secret-tool:search*)"
    ]
  }
}
